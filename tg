local function mkLabel(parent, text, pos, size, align)
    local t = Instance.new("TextLabel")
    t.Position = pos; t.Size = size; t.BackgroundTransparency = 1; t.Text = text
    t.TextColor3 = Color3.fromRGB(230, 230, 230); t.TextScaled = true
