--==================================================
-- SAFE DODGE ENGINE (v4)
--==================================================

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude
overlapParams.MaxParts = 50

local envParams = RaycastParams.new()
envParams.FilterType = Enum.RaycastFilterType.Exclude

local threatParams = OverlapParams.new()
threatParams.FilterType = Enum.RaycastFilterType.Exclude
threatParams.MaxParts = 12

local tracked = {}
local trackLastCleanup = 0
local TRACK_TTL = 0.6

local pendingSpawn = {}
local spawnCheckQueued = false
local lastDodgePerPart = {}

local function getStatsText()
    local d = state.dodge
    return string.format("рывков: %d · срочных: %d · отказов: %d · сигналов: %d",
        d._dodges, d._dodgesUrgent, d._refused, state.intel.liveSignals)
end

-- классификация: опасна ли часть
local function isDangerPart(part)
    if not part or not part.Parent then return false end
    if char and part:IsDescendantOf(char) then return false end
    local n = string.lower(part.Name)
    for i = 1, #ATK_KEYS do
        if string.find(n, ATK_KEYS[i], 1, true) then return true end
    end
    if part:FindFirstChildWhichIsA("ParticleEmitter")
        or part:FindFirstChildWhichIsA("Beam")
        or part:FindFirstChildWhichIsA("Trail")
        or part:FindFirstChildWhichIsA("Fire") then
        return true
    end
    if part.Size.Magnitude < 6 and not part.Anchored then return true end
    return false
end

-- проверка: стена + пол + чужие атаки
local function isPositionSafe(pos)
    if not char or not hrp then return false end
    -- 1) стена между игроком и точкой
    envParams.FilterDescendantsInstances = { char, workspace.CurrentCamera }
    local toTarget = pos - hrp.Position
    if toTarget.Magnitude > 0.1 then
        local wallHit = workspace:Raycast(hrp.Position, toTarget, envParams)
        if wallHit then return false end
    end
    -- 2) пол под целевой точкой
    local floorHit = workspace:Raycast(pos + Vector3.new(0, 1, 0),
        Vector3.new(0, -6, 0), envParams)
    if not floorHit then return false end
    -- 3) чужие атаки в целевой точке
    threatParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(pos, state.dodge.safeMargin, threatParams)
    for _, p in ipairs(parts) do
        if isDangerPart(p) then return false end
    end
    return true
end

-- кандидаты: от источника + перпендикуляры к скорости + веер ±45°
local function buildCandidates(myPos, sourcePos, velDir)
    local baseDirs = {}
    if sourcePos then
        local away = Vector3.new(myPos.X - sourcePos.X, 0, myPos.Z - sourcePos.Z)
        if away.Magnitude > 0.1 then baseDirs[#baseDirs + 1] = away.Unit end
    end
    if velDir and velDir.Magnitude > 0.1 then
        local v = Vector3.new(velDir.X, 0, velDir.Z)
        if v.Magnitude > 0.1 then
            v = v.Unit
            local perp = Vector3.new(-v.Z, 0, v.X)
            baseDirs[#baseDirs + 1] = perp
            baseDirs[#baseDirs + 1] = -perp
        end
    end
    if #baseDirs == 0 then
        local a = math.random() * math.pi * 2
        baseDirs[1] = Vector3.new(math.cos(a), 0, math.sin(a))
    end

    local seen, out = {}, {}
    for _, b in ipairs(baseDirs) do
        for angle = -45, 45, 15 do
            local rot = CFrame.Angles(0, math.rad(angle), 0)
            local d = (rot * b)
            d = Vector3.new(d.X, 0, d.Z)
            if d.Magnitude > 0.01 then
                d = d.Unit
                local key = string.format("%.1f_%.1f", d.X, d.Z)
                if not seen[key] then
                    seen[key] = true
                    out[#out + 1] = d
                end
            end
        end
    end
    return out
end

local function findSafeDodgePosition(myPos, sourcePos, velDir)
    local dirs = buildCandidates(myPos, sourcePos, velDir)
    for _, d in ipairs(dirs) do
        local pos = myPos + d * state.dodge.dodgeDist
        if isPositionSafe(pos) then return pos end
    end
    return nil
end

local function doDodgeAt(safePos, urgent)
    local d = state.dodge
    if not safePos then d._refused += 1; dodgeStats.Text = getStatsText(); return end
    local now = os.clock()
    local cd = urgent and d.urgentCD or d.cooldown
    if now - d._lastDodge < cd then return end
    if not char or not hrp then return end
    d._lastDodge = now
    if urgent then d._dodgesUrgent += 1 else d._dodges += 1 end
    dodgeStats.Text = getStatsText()
    pcall(function() char:PivotTo(CFrame.new(safePos)) end)
end

--==================================================
-- SPAWN DETECTOR (Layer 3) — batched
--==================================================

workspace.DescendantAdded:Connect(function(o)
    if not state.dodge.enabled then return end
    if not o:IsA("BasePart") then return end
    pendingSpawn[#pendingSpawn + 1] = o
    if spawnCheckQueued then return end
    spawnCheckQueued = true
    task.defer(function()
        spawnCheckQueued = false
        local list = pendingSpawn
        pendingSpawn = {}
        if not hrp then return end
        local myPos = hrp.Position
        local d = state.dodge
        for _, part in ipairs(list) do
            if part.Parent then
                local dist = (part.Position - myPos).Magnitude
                if dist <= d.spawnRadius then
                    local hot = false
                    if dist < 3 then hot = true end
                    if not hot and nameIsAttack(part.Name) then hot = true end
                    if not hot and part:FindFirstChildWhichIsA("ParticleEmitter") then hot = true end
                    if not hot and (part:FindFirstChildWhichIsA("Beam")
                        or part:FindFirstChildWhichIsA("Trail")) then hot = true end
                    if not hot and part:FindFirstChildWhichIsA("Fire") then hot = true end
                    if not hot and part.Size.Magnitude < 6 and not part.Anchored then
                        hot = true
                    end
                    if hot then
                        local now = os.clock()
                        local lastT = lastDodgePerPart[part] or 0
                        if now - lastT > 0.2 then
                            lastDodgePerPart[part] = now
                            state.intel.liveSignals += 1
                            local safePos = findSafeDodgePosition(myPos,
                                part.Position, part.AssemblyLinearVelocity)
                            doDodgeAt(safePos, true)
                        end
                    end
                    tracked[part] = { pos = part.Position, t = os.clock(), lastSeen = os.clock() }
                end
            end
        end
    end)
end)

