function scanWorkspace()
    local list = {}
    local max = state.parts.maxList
    local q = string.lower(state.parts.filter)
    local c = player.Character
    for _, obj in ipairs(workspace:GetDescendants()) do
        if #list >= max then break end
        if obj:IsA("BasePart") and not (c and obj:IsDescendantOf(c)) then
            if not state.parts.showAnchoredOnly or obj.Anchored then
                if q == "" or string.find(string.lower(obj.Name), q, 1, true) then
                    list[#list + 1] = obj
                end
            end
        end
    end
    state.parts._list = list
    statusLabel.Text = #list .. " частей"
end

