--==================================================
-- CLASSIFY + ANALYZE (with velocity passthrough)
--==================================================

local function classifyThreat(part)
    if part:FindFirstChildWhichIsA("Beam") then return "beam" end
    if part:FindFirstChildWhichIsA("ParticleEmitter")
        or part:FindFirstChildWhichIsA("Trail")
        or part:FindFirstChildWhichIsA("Fire") then return "vfx" end
    if nameIsAttack(part.Name) then return "named" end
    if part.Size.Magnitude < 8 and not part.Anchored then return "projectile" end
    return "projectile"
end

-- v8: velOverride — передаём из дельта-трекера
local function analyzeThreat(part, myPos, velOverride)
    local vel = velOverride or part.AssemblyLinearVelocity
    local mag = vel.Magnitude
    if mag < 5 then return nil end
    local toMe = myPos - part.Position
    local dist = toMe.Magnitude
    if dist < 0.5 then return nil end
    local approach = vel.Unit:Dot(toMe.Unit)
    if approach < 0.10 then return nil end
    local closing = vel:Dot(toMe.Unit)
    if closing <= 0.1 then return nil end
    local tti = dist / closing

    -- калибровка средней скорости
    local d = state.dodge
    d._calibN += 1; d._calibSpeed += mag
    if d._calibN >= 25 then
        d._avgSpeed = d._calibSpeed / d._calibN
        d._calibN = 0; d._calibSpeed = 0
    end

    return {
        tti = tti,
        impact = part.Position + vel * tti,
        partPos = part.Position,
        vel = vel,
        dist = dist,
        approach = approach,
        mag = mag,
        partSize = part.Size.Magnitude,
        type = classifyThreat(part),
    }
end

--==================================================
-- AUTO DISTANCE
--==================================================

local function computeAutoDist(threat)
    if not threat then return 14 end
    local d = state.dodge
    local base = 10
    base += math.min(threat.partSize or 5, 20) * 0.35
    base += math.min((threat.mag or 0) / 100, 2.5) * 4
    if threat.tti and threat.tti < 0.15 then base *= 1.35 end
    return math.clamp(base, d.autoMinDist, d.autoMaxDist)
end

--==================================================
-- WALL / FLOOR / FULL SAFE
--==================================================

-- снаряд — не стена
local function isRealWall(hitPart)
    if not hitPart or not hitPart.Parent then return false end
    if char and hitPart:IsDescendantOf(char) then return false end
    if hitPart.Size.Magnitude < 8 then return false end
    if nameIsAttack(hitPart.Name) then return false end
    if hitPart:FindFirstChildWhichIsA("ParticleEmitter")
        or hitPart:FindFirstChildWhichIsA("Beam")
        or hitPart:FindFirstChildWhichIsA("Trail")
        or hitPart:FindFirstChildWhichIsA("Fire") then return false end
    return true
end

local function wallClear(pos)
    if not hrp then return true end
    wallParams.FilterDescendantsInstances = { char, workspace.CurrentCamera }
    local d = pos - hrp.Position
    if d.Magnitude < 0.1 then return true end
    local hit = workspace:Raycast(hrp.Position, d, wallParams)
    if not hit then return true end
    return not isRealWall(hit.Instance)
end

local function hasFloor(pos)
    floorParams.FilterDescendantsInstances = { char }
    return workspace:Raycast(pos + Vector3.new(0, 0.5, 0), Vector3.new(0, -20, 0), floorParams) ~= nil
end

local function fullSafe(pos)
    if not wallClear(pos) then return false end
    -- пол проверяем только если стоим на земле
    if hum and hum.FloorMaterial ~= Enum.Material.Air then
        if not hasFloor(pos) then return false end
    end
    threatParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(pos, 2.5, threatParams)
    for _, p in ipairs(parts) do
        if not p:IsDescendantOf(char) then
            local cls = classifyThreat(p)
            if cls == "beam" or cls == "vfx" or nameIsAttack(p.Name) then return false end
        end
    end
    return true
end

--==================================================
-- BUILD BASES (направления)
--==================================================

local function buildBases(myPos, threat)
    local bases, seen = {}, {}
    local function add(v)
        if not v then return end
        v = Vector3.new(v.X, 0, v.Z)
        if v.Magnitude < 0.05 then return end
        v = v.Unit
        local k = string.format("%.2f_%.2f", v.X, v.Z)
        if seen[k] then return end
        seen[k] = true
        bases[#bases + 1] = v
    end
    if threat then
        -- 1) ОТ СНАРЯДА (главное — даже если impact ≈ player)
        if threat.partPos then add(myPos - threat.partPos) end
        -- 2) от предсказанной точки удара
        if threat.impact then add(myPos - threat.impact) end
        -- 3) перпендикуляры к скорости
        if threat.vel and threat.vel.Magnitude > 0.1 then
            local v = Vector3.new(threat.vel.X, 0, threat.vel.Z)
            if v.Magnitude > 0.1 then
                v = v.Unit
                add(Vector3.new(-v.Z, 0, v.X))
                add(Vector3.new(v.Z, 0, -v.X))
                -- 4) назад вдоль скорости
                add(-v)
            end
        end
    end
    -- всегда добавляем 4 кардинала как fallback (дедуп через seen)
    for _, c in ipairs(CARDINAL) do add(c) end
    return bases
end

--==================================================
-- FIND SAFE POSITION — v8 гарантирует горизонталь
--==================================================

local function findSafeDodgePosition(myPos, threat, urgency)
    local dd = computeAutoDist(threat)
    local bases = buildBases(myPos, threat)

    if urgency == "emergency" then
        -- пробуем ВСЕ базы, wallClear only
        for _, b in ipairs(bases) do
            local p = myPos + b * dd
            if wallClear(p) then return p, dd end
        end
        -- половина дистанции
        for _, b in ipairs(bases) do
            local p = myPos + b * (dd * 0.6)
            if wallClear(p) then return p, dd * 0.6 end
        end
        -- совсем последний шанс: кардинал full
        for _, c in ipairs(CARDINAL) do
            local p = myPos + c * dd
            if wallClear(p) then return p, dd end
        end
        -- вертикаль — только если реально зажат
        return nil
    elseif urgency == "fast" then
        for _, b in ipairs(bases) do
            local p = myPos + b * dd
            if wallClear(p) then return p, dd end
        end
        -- кардинал fallback
        for _, c in ipairs(CARDINAL) do
            local p = myPos + c * dd
            if wallClear(p) then return p, dd end
        end
        return nil
    else
        -- normal: веер ±45° вокруг каждой базы + кардиналы
        for _, b in ipairs(bases) do
            for angle = -45, 45, 15 do
                local rot = CFrame.Angles(0, math.rad(angle), 0)
                local dir = rot * b
                dir = Vector3.new(dir.X, 0, dir.Z)
                if dir.Magnitude > 0.01 then
                    local p = myPos + dir.Unit * dd
                    if fullSafe(p) then return p, dd end
                end
            end
        end
        -- кардинал без веера
        for _, c in ipairs(CARDINAL) do
            local p = myPos + c * dd
            if fullSafe(p) then return p, dd end
        end
        return nil
    end
end

--==================================================
-- APPLY DODGE
--==================================================

local function applyDodge(safePos, type)
    if not char or not hrp then return false end
    local ok, err = pcall(function() char:PivotTo(CFrame.new(safePos)) end)
    if not ok then
        errCount += 1
        if lastErr == "" then
            lastErr = tostring(err):sub(1, 50)
            errLabel.Text = "ERR(" .. errCount .. "): " .. lastErr
            errLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
        return false
    end
    -- КРИТИЧНО: стоп физику
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function registerDodge(type)
    local d = state.dodge
    d._dodges += 1
    if type == "emergency" then d._emergency += 1 end
    dodgeStats.Text = getStatsText()
end

--==================================================
-- TRY DODGE
--==================================================

local function tryDodge(part, threat)
    if not threat or not hrp then return false end
    local now = os.clock()
    local ts = threatState[part]
    if not ts then ts = { lastDodge = 0, lastDist = 999 } end

    local urgency
    if threat.tti < 0.10 then urgency = "emergency"
    elseif threat.tti < 0.20 then urgency = "fast"
    else urgency = "normal" end

    local cd = (urgency == "emergency") and 0.04 or 0.08
    if now - ts.lastDodge < cd then return false end

    if ts.lastDodge > 0 and threat.dist < ts.lastDist - 0.5 then
        state.dodge._reEngage += 1
    end

    local safe, usedDist = findSafeDodgePosition(hrp.Position, threat, urgency)
    if not safe then
        ts.lastDodge = now; ts.lastDist = threat.dist
        threatState[part] = ts
        state.dodge._refused += 1
        dodgeStats.Text = getStatsText()
        return false
    end
    if not applyDodge(safe, urgency) then return false end

    ts.lastDodge = now; ts.lastDist = threat.dist
    threatState[part] = ts
    registerDodge(urgency)
    -- обновляем инфо-лейбл авто-дистанции
    distLabel.Text = string.format("авто-дистанция: ~%.0f studs", usedDist or 14)
    return true
end

--==================================================
-- SPAWN DETECTOR
--==================================================

local pendingSpawn = {}
local spawnCheckQueued = false
local lastSpawnDodge = {}
local spawnTrack = {}

workspace.DescendantAdded:Connect(function(o)
    if not state.dodge.enabled then return end
    if not o:IsA("BasePart") then return end
    pendingSpawn[#pendingSpawn + 1] = o
    if spawnCheckQueued then return end
    spawnCheckQueued = true
    task.defer(function()
        spawnCheckQueued = false
        local list = pendingSpawn; pendingSpawn = {}
        if not hrp then return end
        local myPos = hrp.Position
        for _, part in ipairs(list) do
            if part.Parent then
                local dist = (part.Position - myPos).Magnitude
                if dist <= state.dodge.reactRadius then
                    local hot = (dist < 3.5) or nameIsAttack(part.Name)
                        or part:FindFirstChildWhichIsA("ParticleEmitter")
                        or part:FindFirstChildWhichIsA("Beam")
                        or part:FindFirstChildWhichIsA("Trail")
                        or part:FindFirstChildWhichIsA("Fire")
                    if hot then
                        local now = os.clock()
                        if now - (lastSpawnDodge[part] or 0) > 0.10 then
                            lastSpawnDodge[part] = now
                            state.intel.liveSignals += 1
                            -- первый анализ: если velocity=0 (CFrame), ждём дельту
                            local threat = analyzeThreat(part, myPos)
                            if threat then
                                tryDodge(part, threat)
                            else
                                -- частый случай: anchored+CFrame → ждём следующего кадра для дельты
                                spawnTrack[part] = { pos = part.Position, t = now }
                            end
                        end
                    end
                    tracked[part] = { pos = part.Position, t = os.clock(), lastSeen = os.clock() }
                end
            end
        end
    end)
end)

--==================================================
-- HEARTBEAT (dodge + follow)
--==================================================

RunService.Heartbeat:Connect(function()
    local now = os.clock()

    -- ==== FOLLOW ====
    local f = state.follow
    if f.enabled and char then
        if not f._target or not f._target.Parent then
            f._target = findPartByName(f.targetName)
            if f._target then
                followStatus.Text = "найден: " .. f.targetName
                followStatus.TextColor3 = Color3.fromRGB(150, 255, 180)
                f._lastPos = nil
            else
                followStatus.Text = "ждёт: " .. f.targetName
                followStatus.TextColor3 = Color3.fromRGB(255, 200, 80)
            end
        end
        if f._target and f._target.Parent then
            local targetPos = f._target.Position + f.offset
            if not f._lastPos or (targetPos - f._lastPos).Magnitude >= 0.1 then
                f._lastPos = targetPos
                local ok = pcall(function() char:PivotTo(CFrame.new(targetPos)) end)
                if ok and hrp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end

    -- ==== DODGE ====
    local d = state.dodge
    if not d.enabled or not hrp or not hum or hum.Health <= 0 then return end
    local myPos = hrp.Position

    -- health fallback
    if d._lastHealth and hum.Health < d._lastHealth - 0.01 then
        state.intel.liveSignals += 1
        local safe = findSafeDodgePosition(myPos, nil, "emergency")
        if safe and applyDodge(safe, "emergency") then registerDodge("emergency") end
    end
    d._lastHealth = hum.Health

    overlapParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(myPos, d.reactRadius, overlapParams)

    local bestPart, bestThreat, bestScore = nil, nil, 0
    for _, part in ipairs(parts) do
        if part ~= hrp then
            local tr = tracked[part]
            local velFromDelta
            if tr then
                local dt = now - tr.t
                if dt > 0.001 then velFromDelta = (part.Position - tr.pos) / dt end
            end
            tracked[part] = { pos = part.Position, t = now, lastSeen = now }

            -- v8: выбираем максимальную скорость — физическую ИЛИ дельту
            local physVel = part.AssemblyLinearVelocity
            local vel = physVel
            if velFromDelta and velFromDelta.Magnitude > vel.Magnitude then vel = velFromDelta end

            if vel.Magnitude >= 5 then
                -- v8: передаём vel внутрь analyzeThreat!
                local threat = analyzeThreat(part, myPos, vel)
                if threat then
                    local pri = 1
                    if threat.type == "beam" then pri = 3
                    elseif threat.type == "named" then pri = 2 end
                    if threat.tti < 0.30 or threat.approach > 0.5 then
                        local score = pri * 10 + (1 - math.min(threat.tti, 1))
                        if score > bestScore then
                            bestPart, bestThreat, bestScore = part, threat, score
                        end
                    end
                end
            end

            -- melee
            if not bestPart and part.Name == "HumanoidRootPart" then
                local model = part.Parent
                if model and model ~= char then
                    local eHum = model:FindFirstChildOfClass("Humanoid")
                    if eHum and eHum.Health > 0 then
                        local toPlayer = myPos - part.Position
                        local dist = toPlayer.Magnitude
                        if dist < 12 and part.CFrame.LookVector:Dot(toPlayer.Unit) > 0.5 then
                            local safe = findSafeDodgePosition(myPos, {
                                partPos = part.Position,
                                impact = part.Position,
                                vel = toPlayer,
                                dist = dist, tti = 0.1, mag = 20,
                                partSize = 4,
                            }, "fast")
                            if safe and applyDodge(safe, "fast") then registerDodge("fast") end
                        end
                    end
                end
            end
        end
    end

    -- spawn-track deferred threats (для anchored+CFrame)
    for part, tr in pairs(spawnTrack) do
        if not part.Parent then spawnTrack[part] = nil
        else
            local dt = now - tr.t
            if dt > 0.001 then
                local vel = (part.Position - tr.pos) / dt
                if vel.Magnitude >= 5 then
                    local threat = analyzeThreat(part, myPos, vel)
                    if threat and threat.tti < 0.25 then
                        tryDodge(part, threat)
                    end
                end
                if now - tr.t > 0.3 then spawnTrack[part] = nil end
            end
        end
    end

    if bestPart and bestThreat then
        state.intel.liveSignals += 1
        tryDodge(bestPart, bestThreat)
    end

    -- cleanup
    if now - trackLastCleanup > 1 then
        trackLastCleanup = now
        for p, tr in pairs(tracked) do
            if now - tr.lastSeen > TRACK_TTL or not p.Parent then tracked[p] = nil end
        end
        for p in pairs(threatState) do if not p.Parent then threatState[p] = nil end end
        for p in pairs(lastSpawnDodge) do if not p.Parent then lastSpawnDodge[p] = nil end end
    end
end)

