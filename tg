}
local function nameIsAttack(name)
    local n = string.lower(name)
    for i = 1, #ATK_KEYS do
        if string.find(n, ATK_KEYS[i], 1, true) then return true end
    end
    return false
end

local HOT_TAGS = {"Projectile","Attack","Damage","Hitbox","Hazard",
