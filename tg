--==================================================
-- CLASSIFY
--==================================================

local function classifyThreat(part)
    if part:FindFirstChildWhichIsA("Beam") then return "beam" end
    if part:FindFirstChildWhichIsA("ParticleEmitter")
        or part:FindFirstChildWhichIsA("Trail")
        or part:FindFirstChildWhichIsA("Fire") then return "vfx" end
    if nameIsAttack(part.Name) then return "named" end
    return "projectile"
end

--==================================================
-- ANALYZE (v10: никаких аллокаций — таблица из пула)
--==================================================

local analysisPool = {}
local analysisIdx = 0
local function getAnalysis()
    analysisIdx = analysisIdx + 1
    if analysisIdx > 20 then analysisIdx = 1 end
    if not analysisPool[analysisIdx] then analysisPool[analysisIdx] = {} end
    return analysisPool[analysisIdx]
end

local function analyzeThreat(part, myPos, velOverride)
    local vel = velOverride or part.AssemblyLinearVelocity
    local mag = vel.Magnitude
    if mag < 5 then return nil end
    local dx = myPos.X - part.Position.X
    local dy = myPos.Y - part.Position.Y
    local dz = myPos.Z - part.Position.Z
    local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
    if dist < 0.5 then return nil end
    local invDist = 1 / dist
    local approach = (vel.X*dx + vel.Y*dy + vel.Z*dz) * invDist / mag
    if approach < 0.10 then return nil end
    local closing = mag * approach
    if closing <= 0.1 then return nil end
    local tti = dist / closing

    local a = getAnalysis()
    a.tti = tti
    a.partPos = part.Position
    a.impact = part.Position + vel * tti
    a.vel = vel
    a.dist = dist
    a.approach = approach
    a.mag = mag
    a.partSize = part.Size.Magnitude
    a.type = classifyThreat(part)
    a.part = part
    return a
end

--==================================================
-- AUTO DISTANCE
--==================================================

local function computeAutoDist(threat)
    if not threat then return 14 end
    local d = state.dodge
    local halfW = (threat.partSize or 4) * 0.5
    local base = 10
    base += math.min((threat.mag or 0) / 100, 2.5) * 3
    if threat.tti and threat.tti < 0.15 then base *= 1.25 end
    base = math.max(base, halfW + 8)
    return math.clamp(base, d.autoMinDist, d.autoMaxDist)
end

--==================================================
-- PATH / WALL / FLOOR
--==================================================

local function pathClear(dest, threat)
    if not threat or not threat.partPos then return true end
    local projHalf = (threat.partSize or 4) * 0.5
    local dx = dest.X - threat.partPos.X
    local dy = dest.Y - threat.partPos.Y
    local dz = dest.Z - threat.partPos.Z
    if (dx*dx + dy*dy + dz*dz) < (projHalf + 3) * (projHalf + 3) then return false end
    local v = threat.vel
    if not v or v.Magnitude < 0.1 then return true end
    local vLen = v.Magnitude
    local vx, vy, vz = v.X/vLen, v.Y/vLen, v.Z/vLen
    local alongPath = dx*vx + dy*vy + dz*vz
    if alongPath < 0 then return true end
    local px = dx - vx * alongPath
    local py = dy - vy * alongPath
    local pz = dz - vz * alongPath
    local perpDist = math.sqrt(px*px + py*py + pz*pz)
    return perpDist > (projHalf + 4)
end

local function isRealWall(hitPart)
    if not hitPart or not hitPart.Parent then return false end
    if char and hitPart:IsDescendantOf(char) then return false end
    local sz = hitPart.Size
    if sz.Magnitude < 8 then return false end
    if nameIsAttack(hitPart.Name) then return false end
    if hitPart:FindFirstChildWhichIsA("ParticleEmitter")
        or hitPart:FindFirstChildWhichIsA("Beam")
        or hitPart:FindFirstChildWhichIsA("Trail")
        or hitPart:FindFirstChildWhichIsA("Fire") then return false end
    return true
end

-- v10: single cast для emergency/fast, cast-through 3 для normal
local function wallClear(pos, fastMode)
    if not hrp then return true end
    wallParams.FilterDescendantsInstances = { char, workspace.CurrentCamera }
    local from = hrp.Position
    local iter = fastMode and 2 or 3
    for _ = 1, iter do
        local d = pos - from
        if d.Magnitude < 0.3 then return true end
        local hit = workspace:Raycast(from, d, wallParams)
        if not hit then return true end
        if isRealWall(hit.Instance) then return false end
        from = hit.Position + d.Unit * 0.3
    end
    return true
end

local function hasFloor(pos)
    floorParams.FilterDescendantsInstances = { char }
    return workspace:Raycast(pos + Vector3.new(0, 0.5, 0),
        Vector3.new(0, -20, 0), floorParams) ~= nil
end

--==================================================
-- BASES (v10: меньще, без near-duplicate floating point)
--==================================================

local function buildBases(myPos, threat, urgency)
    local bases, seen = {}, {}
    local function add(vx, vz)
        local m = math.sqrt(vx*vx + vz*vz)
        if m < 0.05 then return end
        vx, vz = vx / m, vz / m
        local k = string.format("%d_%d", math.floor(vx*10), math.floor(vz*10))
        if seen[k] then return end
        seen[k] = true
        bases[#bases + 1] = Vector3.new(vx, 0, vz)
    end

    -- 1) перпендикуляры — самое безопасное
    if threat and threat.vel and threat.vel.Magnitude > 0.5 then
        local v = threat.vel
        add(-v.Z, v.X)
        add(v.Z, -v.X)
    end
    -- 2) away от снаряда
    if threat and threat.partPos then
        add(myPos.X - threat.partPos.X, myPos.Z - threat.partPos.Z)
    end
    -- 3) cardinal
    if urgency ~= "emergency" then
        add(1, 0); add(-1, 0); add(0, 1); add(0, -1)
    end
    if #bases == 0 then add(1, 0); add(-1, 0) end
    return bases
end

--==================================================
-- IS SPOT SAFE (v10: pathClear первым, потом wall, потом floor)
--==================================================

local function isSpotSafe(pos, threats, urgency)
    -- 1) дешёвая проверка пути (no physics)
    for i = 1, #threats do
        if not pathClear(pos, threats[i]) then return false end
    end
    -- 2) стена
    if not wallClear(pos, urgency == "emergency") then return false end
    -- 3) пол (только если на земле)
    if urgency == "normal" and hum and hum.FloorMaterial ~= Enum.Material.Air then
        if not hasFloor(pos) then return false end
    end
    -- 4) соседние атаки (только normal)
    if urgency == "normal" then
        threatParams.FilterDescendantsInstances = { char }
        local p = workspace:GetPartBoundsInRadius(pos, 2.5, threatParams)
        for i = 1, #p do
            local h = p[i]
            if not h:IsDescendantOf(char) then
                if h:FindFirstChildWhichIsA("Beam")
                   or h:FindFirstChildWhichIsA("ParticleEmitter")
                   or nameIsAttack(h.Name) then
                    return false
                end
            end
        end
    end
    return true
end

--==================================================
-- FIND SAFE POSITION (v10: capped candidates)
--==================================================

local function findSafeDodgePosition(myPos, primaryThreat, threats, urgency)
    local dd = computeAutoDist(primaryThreat)
    local bases = buildBases(myPos, primaryThreat, urgency)
    local dists
    if urgency == "emergency" then
        dists = { dd }
    elseif urgency == "fast" then
        dists = { dd, dd * 0.85 }
    else
        dists = { dd, dd * 0.85, dd * 1.15 }
    end

    local tries = 0
    for di = 1, #dists do
        local useDist = dists[di]
        for bi = 1, #bases do
            tries = tries + 1
            if tries > MAX_CANDIDATES then return nil end
            local b = bases[bi]
            local pos = myPos + Vector3.new(b.X * useDist, 0, b.Z * useDist)
            if isSpotSafe(pos, threats, urgency) then
                return pos, useDist
            end
        end
    end
    return nil
end

--==================================================
-- APPLY DODGE
--==================================================

local function applyDodge(safePos)
    if not char or not hrp then return false end
    local ok, err = pcall(function() char:PivotTo(CFrame.new(safePos)) end)
    if not ok then
        errCount += 1
        if lastErr == "" then
            lastErr = tostring(err):sub(1, 50)
        end
        return false
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    return true
end

--==================================================
-- TRY DODGE (v10: глобальный CD + флаг кадра)
--==================================================

local function tryDodge(part, threat, threats)
    if not threat or not hrp then return false end
    local d = state.dodge
    if d._attempted then return false end          -- v10: один TP за кадр
    local now = os.clock()
    if now - d._lastGlobalDodge < d._globalCD then return false end  -- v10: глобальный CD

    local ts = threatState[part]
    if not ts then
        ts = { lastDodge = 0, lastDist = 999 }
        threatState[part] = ts
    end

    local urgency
    if threat.tti < 0.10 then urgency = "emergency"
    elseif threat.tti < 0.20 then urgency = "fast"
    else urgency = "normal" end

    local cd = (urgency == "emergency") and 0.04 or 0.08
    if now - ts.lastDodge < cd then return false end

    if ts.lastDodge > 0 and threat.dist < ts.lastDist - 0.5 then
        d._reEngage += 1
    end

    local safe, usedDist = findSafeDodgePosition(hrp.Position, threat, threats, urgency)
    if not safe then
        ts.lastDodge = now; ts.lastDist = threat.dist
        d._noSpace += 1
        d._attempted = true
        dodgeStats.Text = getStatsText()
        return false
    end
    if not applyDodge(safe) then
        d._attempted = true
        return false
    end

    ts.lastDodge = now; ts.lastDist = threat.dist
    d._dodges += 1
    if urgency == "emergency" then d._emergency += 1 end
    d._lastGlobalDodge = now
    d._attempted = true
    dodgeStats.Text = getStatsText()
    distLabel.Text = string.format("авто-дистанция: ~%.0f studs", usedDist or 14)
    -- v10: follow пауза
    state.follow._pauseUntil = now + 0.5
    return true
end

--==================================================
-- SPAWN DETECTOR (v10: capped batch)
--==================================================

local pendingSpawn = {}
local spawnCheckQueued = false

workspace.DescendantAdded:Connect(function(o)
    if not state.dodge.enabled then return end
    if not o:IsA("BasePart") then return end
    if #pendingSpawn >= 50 then return end         -- v10: hard cap
    pendingSpawn[#pendingSpawn + 1] = o
    if spawnCheckQueued then return end
    spawnCheckQueued = true
    task.defer(function()
        spawnCheckQueued = false
        local list = pendingSpawn; pendingSpawn = {}
        if not hrp then return end
        local myPos = hrp.Position
        local processed = 0
        for i = 1, #list do
            if processed >= 20 then break end      -- v10: max 20 per defer
            local part = list[i]
            if part.Parent then
                local dx = part.Position.X - myPos.X
                local dy = part.Position.Y - myPos.Y
                local dz = part.Position.Z - myPos.Z
                local distSq = dx*dx + dy*dy + dz*dz
                if distSq <= state.dodge.reactRadius * state.dodge.reactRadius then
                    local hot = distSq < 12
                        or nameIsAttack(part.Name)
                        or part:FindFirstChildWhichIsA("ParticleEmitter")
                        or part:FindFirstChildWhichIsA("Beam")
                        or part:FindFirstChildWhichIsA("Trail")
                        or part:FindFirstChildWhichIsA("Fire")
                    if hot then
                        local now = os.clock()
                        local lastT = lastSpawnDodge[part]
                        if not lastT or now - lastT > 0.10 then
                            lastSpawnDodge[part] = now
                            state.intel.liveSignals += 1
                            local threat = analyzeThreat(part, myPos)
                            if threat then
                                tryDodge(part, threat, { threat })
                                processed += 1
                            else
                                if #spawnTrack < MAX_SPAWNTRACK then
                                    spawnTrack[part] = { pos = part.Position, t = now }
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end)

--==================================================
-- HEARTBEAT (v10: минимальные аллокации)
--==================================================

local function cleanupTables(now)
    for p, tr in pairs(tracked) do
        if now - tr.lastSeen > TRACK_TTL or not p.Parent then tracked[p] = nil end
    end
    for p, ts in pairs(threatState) do
        if not p.Parent or now - ts.lastDodge > 3 then threatState[p] = nil end
    end
    for p, tr in pairs(spawnTrack) do
        if not p.Parent or now - tr.t > 0.3 then spawnTrack[p] = nil end
    end
    for p in pairs(lastSpawnDodge) do
        if not p.Parent then lastSpawnDodge[p] = nil end
    end
end

local function evictIfBig()
    if trackedCount > MAX_TRACKED then
        -- evict 20 oldest
        local count = 0
        for p in pairs(tracked) do
            tracked[p] = nil
            count += 1
            if count >= 20 then break end
        end
        trackedCount = 0
    end
end

RunService.Heartbeat:Connect(function()
    local now = os.clock()
    state.dodge._attempted = false                  -- v10: сброс флага кадра

    -- ==== FOLLOW (изолирован от dodge) ====
    local f = state.follow
    -- v10: не ТП-аем если под угрозой ИЛИ пауза
    if f.enabled and char and now > f._pauseUntil and not state.dodge._underThreat then
        if not f._target or not f._target.Parent then
            f._target = findPartByName(f.targetName)
            if f._target then
                followStatus.Text = "найден: " .. f.targetName
                followStatus.TextColor3 = Color3.fromRGB(150, 255, 180)
                f._lastPos = nil
            else
                followStatus.Text = "ждёт: " .. f.targetName
                followStatus.TextColor3 = Color3.fromRGB(255, 200, 80)
            end
        end
        if f._target and f._target.Parent then
            local targetPos = f._target.Position + f.offset
            if not f._lastPos or (targetPos - f._lastPos).Magnitude >= 0.1 then
                f._lastPos = targetPos
                local ok = pcall(function() char:PivotTo(CFrame.new(targetPos)) end)
                if ok and hrp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end

    -- ==== DODGE ====
    local d = state.dodge
    if not d.enabled or not hrp or not hum or hum.Health <= 0 then
        d._underThreat = false
        return
    end
    local myPos = hrp.Position

    -- health fallback
    if d._lastHealth and hum.Health < d._lastHealth - 0.01 then
        state.intel.liveSignals += 1
        if now - d._lastGlobalDodge >= d._globalCD then
            local safe = findSafeDodgePosition(myPos, nil, {}, "emergency")
            if safe and applyDodge(safe) then
                d._dodges += 1; d._emergency += 1
                d._lastGlobalDodge = now
                dodgeStats.Text = getStatsText()
                f._pauseUntil = now + 0.5
            end
        end
    end
    d._lastHealth = hum.Health

    overlapParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(myPos, d.reactRadius, overlapParams)
    trackedCount = 0

    -- v10: собираем top-3 угрозы, без аллокаций
    local topThreats = { nil, nil, nil }
    local topScores = { 0, 0, 0 }
    local bestThreat = nil
    local bestScore = 0

    for i = 1, #parts do
        local part = parts[i]
        if part ~= hrp then
            local tr = tracked[part]
            local vel
            if tr then
                local dt = now - tr.t
                if dt > 0.001 then
                    vel = (part.Position - tr.pos) / dt
                end
                tr.pos = part.Position
                tr.t = now
                tr.lastSeen = now
            else
                tracked[part] = { pos = part.Position, t = now, lastSeen = now }
                trackedCount += 1
            end

            local physVel = part.AssemblyLinearVelocity
            local useVel = physVel
            if vel and vel.Magnitude > useVel.Magnitude then useVel = vel end

            if useVel.Magnitude >= 5 then
                local threat = analyzeThreat(part, myPos, useVel)
                if threat then
                    d._underThreat = true
                    -- scoring
                    local pri = 1
                    if threat.type == "beam" then pri = 3
                    elseif threat.type == "named" then pri = 2 end
                    if threat.tti < 0.5 or threat.approach > 0.3 then
                        local score = pri * 10 + (1 - math.min(threat.tti, 1))
                        -- top-3 keep
                        if score > topScores[3] then
                            -- сдвиг
                            if score > topScores[2] then
                                topThreats[3] = topThreats[2]; topScores[3] = topScores[2]
                                if score > topScores[1] then
                                    topThreats[2] = topThreats[1]; topScores[2] = topScores[1]
                                    topThreats[1] = threat; topScores[1] = score
                                else
                                    topThreats[2] = threat; topScores[2] = score
                                end
                            else
                                topThreats[3] = threat; topScores[3] = score
                            end
                        end
                        if score > bestScore then bestThreat = threat; bestScore = score end
                    end
                end
            end

            -- melee (дешёвый)
            if part.Name == "HumanoidRootPart" and not bestThreat then
                local model = part.Parent
                if model and model ~= char then
                    local eHum = model:FindFirstChildOfClass("Humanoid")
                    if eHum and eHum.Health > 0 then
                        local toPlayer = myPos - part.Position
                        local dist = toPlayer.Magnitude
                        if dist < 12 and dist > 0.1 and part.CFrame.LookVector:Dot(toPlayer.Unit) > 0.5 then
                            local fake = {
                                partPos = part.Position, impact = part.Position,
                                vel = toPlayer, dist = dist, tti = 0.1,
                                mag = 20, partSize = 4, part = part,
                            }
                            if tryDodge(part, fake, { fake }) then break end
                        end
                    end
                end
            end
        end
    end

    -- spawn-track (anchored+CFrame deferred)
    for part, tr in pairs(spawnTrack) do
        if part.Parent then
            local dt = now - tr.t
            if dt > 0.001 and dt < 0.3 then
                local vel = (part.Position - tr.pos) / dt
                if vel.Magnitude >= 5 then
                    local threat = analyzeThreat(part, myPos, vel)
                    if threat and threat.tti < 0.25 then
                        if tryDodge(part, threat, { threat }) then break end
                    end
                end
            end
        end
    end

    -- primary
    if bestThreat and not d._attempted then
        state.intel.liveSignals += 1
        -- фильтруем nil из topThreats
        local list = {}
        for i = 1, 3 do if topThreats[i] then list[#list+1] = topThreats[i] end end
        tryDodge(bestThreat.part, bestThreat, list)
    end

    if not d._underThreat then d._underThreat = (bestThreat ~= nil) end

    -- cleanup
    if now - trackLastCleanup > 0.8 then
        trackLastCleanup = now
        cleanupTables(now)
        evictIfBig()
        perfLabel.Text = string.format("FPS-нагрузка: OK · tracked: %d", trackedCount)
    end
end)

