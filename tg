end)
player:GetPropertyChangedSignal("Character"):Connect(function()
    if player.Character ~= char then updateChar(player.Character) end
end)

task.spawn(function()
    while true do
        task.wait(0.5)
        if not char then
            if player.Character then updateChar(player.Character) end
        else
            local need = false
            if player.Character ~= char then need = true
            elseif not primary or not primary.Parent or not primary:IsDescendantOf(char) then need = true
            elseif not hum or not hum.Parent or not hum:IsDescendantOf(char) then need = true end
            if need then
                local np = resolvePrimary(char)
                local nh = resolveHumanoid(char)
                if np ~= primary or nh ~= hum then
                    primary = np; hum = nh
                    if hum then state.dodge._lastHealth = hum.Health end
                    if state.dodge.hoverEnabled then task.defer(updateHover) end
                end
            end
        end
    end
end)

