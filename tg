local analysisPool = {}
local analysisIdx = 0
local function getAnalysis()
    analysisIdx = analysisIdx + 1
    if analysisIdx > 25 then analysisIdx = 1 end
    if not analysisPool[analysisIdx] then analysisPool[analysisIdx] = {} end
    return analysisPool[analysisIdx]
end

local function threatHalfDim(part)
    local s = part.Size
    return (s.X + s.Y + s.Z) / 6
end

local function analyzeThreat(part, myPos, velOverride)
    local vel = velOverride or part.AssemblyLinearVelocity
    local mag = vel.Magnitude
    if mag < 3 then return nil end
    local dx = myPos.X - part.Position.X
    local dy = myPos.Y - part.Position.Y
    local dz = myPos.Z - part.Position.Z
    local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
    if dist < 0.5 then return nil end
    local invDist = 1 / dist
    local approach = (vel.X*dx + vel.Y*dy + vel.Z*dz) * invDist / mag
    if approach < 0.05 then return nil end
    local closing = mag * approach
    if closing <= 0.05 then return nil end
    local tti = dist / closing

    local a = getAnalysis()
    a.tti = tti
    a.partPos = part.Position
    a.impact = part.Position + vel * tti
    a.vel = vel
    a.dist = dist
    a.approach = approach
    a.mag = mag
    a.partSize = part.Size.Magnitude
    a.halfDim = threatHalfDim(part)
    a.type = classifyThreat(part)
    a.part = part
    return a
end

local function makeStaticThreat(part, myPos)
    local dx = myPos.X - part.Position.X
    local dy = myPos.Y - part.Position.Y
    local dz = myPos.Z - part.Position.Z
    local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
    local a = getAnalysis()
    a.tti = 0.05
    a.partPos = part.Position
    a.impact = part.Position
    a.vel = Vector3.new(0.1, 0, 0.1)
    a.dist = dist
    a.approach = 1
    a.mag = 5
    a.partSize = part.Size.Magnitude
    a.halfDim = threatHalfDim(part)
    a.type = classifyThreat(part)
    a.part = part
    return a
end

--==================================================
-- AUTO DISTANCE
--==================================================

local function computeAutoDist(primaryThreat, threats)
    local base = 12
    local maxHalf = 3
    if threats then
        for i = 1, #threats do
            local t = threats[i]
            if t.halfDim and t.halfDim > maxHalf then maxHalf = t.halfDim end
        end
    end
    if primaryThreat then
        base = math.max(base, primaryThreat.halfDim + 8)
        base = base + math.min((primaryThreat.mag or 0) / 100, 2.5) * 2.5
        if primaryThreat.tti and primaryThreat.tti < 0.15 then base *= 1.2 end
    end
    base = math.max(base, maxHalf + 8)
    return math.clamp(base, state.dodge.autoMinDist, state.dodge.autoMaxDist)
end

--==================================================
-- PATH
--==================================================

local function perpDistToPath(dest, threat)
    local dx = dest.X - threat.partPos.X
    local dy = dest.Y - threat.partPos.Y
    local dz = dest.Z - threat.partPos.Z
    local v = threat.vel
    if not v or v.Magnitude < 0.3 then
        return math.sqrt(dx*dx + dy*dy + dz*dz)
    end
    local vl = v.Magnitude
    local vx, vy, vz = v.X/vl, v.Y/vl, v.Z/vl
    local along = dx*vx + dy*vy + dz*vz
    if along < 0 then return math.sqrt(dx*dx + dy*dy + dz*dz) end
    local px, py, pz = dx - vx*along, dy - vy*along, dz - vz*along
    return math.sqrt(px*px + py*py + pz*pz)
end

local function pathClear(dest, threat)
    if not threat or not threat.partPos then return true end
    local halfW = threat.halfDim or 2
    local dx = dest.X - threat.partPos.X
    local dy = dest.Y - threat.partPos.Y
    local dz = dest.Z - threat.partPos.Z
    if (dx*dx + dy*dy + dz*dz) < (halfW + 3) * (halfW + 3) then return false end
    local v = threat.vel
    if not v or v.Magnitude < 0.3 then return true end
    local vl = v.Magnitude
    local vx, vy, vz = v.X/vl, v.Y/vl, v.Z/vl
    local along = dx*vx + dy*vy + dz*vz
    if along < 0 then return true end
    local px, py, pz = dx - vx*along, dy - vy*along, dz - vz*along
    local perp = math.sqrt(px*px + py*py + pz*pz)
    return perp > (halfW + 4)
end

local function isRealWall(hitPart)
    if not hitPart or not hitPart.Parent then return false end
    if char and hitPart:IsDescendantOf(char) then return false end
    if hitPart.Size.Magnitude < 8 then return false end
    if isDangerPart(hitPart) then return false end
    return true
end

-- v14: единый raycast по направлению — экономит 3-4 вызова на кандидата
local function castWall(from, dir, dist)
    wallParams.FilterDescendantsInstances = { char, workspace.CurrentCamera }
    local target = from + dir * dist
    local hit = workspace:Raycast(from, target - from, wallParams)
    while hit and not isRealWall(hit.Instance) do
        local remaining = dist - (hit.Position - from).Magnitude
        if remaining < 0.3 then return nil end
        from = hit.Position + dir * 0.3
        hit = workspace:Raycast(from, dir * remaining, wallParams)
    end
    return hit
end

local function hasFloor(pos)
    floorParams.FilterDescendantsInstances = { char }
    return workspace:Raycast(pos + Vector3.new(0, 0.5, 0),
        Vector3.new(0, -20, 0), floorParams) ~= nil
end

local function ceilingClear(from, pos)
    if pos.Y <= from.Y + 0.5 then return true end
    ceilingParams.FilterDescendantsInstances = { char, workspace.CurrentCamera }
    local d = pos - from
    local hit = workspace:Raycast(from, d, ceilingParams)
    if not hit then return true end
    return not isRealWall(hit.Instance)
end

local function canGoVertical(myPos)
    ceilingParams.FilterDescendantsInstances = { char, workspace.CurrentCamera }
    local hit = workspace:Raycast(myPos + Vector3.new(0, 1, 0),
        Vector3.new(0, 15, 0), ceilingParams)
    if hit and isRealWall(hit.Instance) then return false end
    return true
end

--==================================================
-- BASES (v14: меньше направлений, cardinal только если нужен)
--==================================================

local function buildBases(myPos, threat, canUp)
    local bases, seen = {}, {}
    local function add(vx, vy, vz)
        local m = math.sqrt(vx*vx + vy*vy + vz*vz)
        if m < 0.05 then return end
        vx, vy, vz = vx/m, vy/m, vz/m
        local k = string.format("%d_%d_%d",
            math.floor(vx*10), math.floor(vy*10), math.floor(vz*10))
        if seen[k] then return end
        seen[k] = true
        bases[#bases + 1] = Vector3.new(vx, vy, vz)
    end

    if threat and threat.vel and threat.vel.Magnitude > 0.5 then
        local v = threat.vel
        local vh = Vector3.new(v.X, 0, v.Z)
        if vh.Magnitude > 0.1 then
            vh = vh.Unit
            add(-vh.Z, 0, vh.X)
            add(vh.Z, 0, -vh.X)
        end
    end
    if threat and threat.partPos then
        local d = myPos - threat.partPos
        add(d.X, 0, d.Z)
    end
    add(1,0,0); add(-1,0,0); add(0,0,1); add(0,0,-1)
    if canUp then
        add(0, 1, 0)
        add(0.4, 1, 0)
    end
    return bases
end

--==================================================
-- SCORE (v14: cheap-first, batch wallcast)
--==================================================

local function scoreSpot(pos, threats, primaryThreat, myPos, isVertical, fromPos)
    -- pre-filter: pathClear (math only, ~free)
    if not pathClear(pos, primaryThreat) then return -math.huge end
    for i = 1, #threats do
        if not pathClear(pos, threats[i]) then return -math.huge end
    end
    -- ceiling для вертикали
    if isVertical and not ceilingClear(fromPos, pos) then return -math.huge end
    -- wallcast один раз на позицию (не на кандидата-итерацию)
    local dir = (pos - fromPos)
    local mDist = dir.Magnitude
    if mDist > 0.1 then
        dir = dir / mDist
        local hit = castWall(fromPos, dir, mDist)
        if hit then return -math.huge end
    end
    -- floor только для горизонтали
    if not isVertical and hum and hum.FloorMaterial ~= Enum.Material.Air then
        if not hasFloor(pos) then return -math.huge end
    end
    -- near-threat (только для нормал, самое дорогое)
    threatParams.FilterDescendantsInstances = { char }
    local nearby = workspace:GetPartBoundsInRadius(pos, 2.5, threatParams)
    for i = 1, #nearby do
        if isDangerPart(nearby[i]) then return -math.huge end
    end

    -- scoring
    local score = 0
    for i = 1, #threats do
        local perp = perpDistToPath(pos, threats[i])
        score = score + math.min(perp / 6, 4)
    end
    if primaryThreat then
        score = score + math.min((pos - primaryThreat.partPos).Magnitude / 10, 3)
    end
    score = score - (pos - myPos).Magnitude * 0.04
    if isVertical then
        score = score + state.dodge.verticalBias * 4
        if primaryThreat and primaryThreat.tti > state.dodge.maxVerticalTTI then
            score = score - 8
        end
    end
    return score
end

--==================================================
-- FIND BEST DODGE POSITION (v14: early-exit + caps)
--==================================================

local function findBestDodgePosition(myPos, primaryThreat, threats, urgency)
    local baseDist = computeAutoDist(primaryThreat, threats)
    local canUp = canGoVertical(myPos)
    local bases = buildBases(myPos, primaryThreat, canUp)

    local maxCand
    if urgency == "emergency" then maxCand = MAX_CAND_EMERGENCY
    elseif urgency == "fast" then maxCand = MAX_CAND_FAST
    else maxCand = MAX_CAND_NORMAL end

    -- v14: только одна дистанция для emergency и fast
    local dists
    if urgency == "emergency" then dists = { baseDist }
    elseif urgency == "fast" then dists = { baseDist, baseDist * 0.85 }
    else dists = { baseDist, baseDist * 1.25 } end

    local best, bestScore, bestV = nil, -math.huge, false
    local tried = 0
    local GOOD_ENOUGH = 6

    for di = 1, #dists do
        local dd = dists[di]
        for bi = 1, #bases do
            tried = tried + 1
            if tried > maxCand then break end
            local b = bases[bi]
            local pos = myPos + b * dd
            local isV = b.Y > 0.5
            local s = scoreSpot(pos, threats, primaryThreat, myPos, isV, myPos)
            if s > bestScore then
                bestScore = s
                best = pos
                bestV = isV
                -- v14: ранний выход при "достаточно хорошем"
                if s >= GOOD_ENOUGH and di == 1 then
                    if state.dodge._peakTried < tried then
                        state.dodge._peakTried = tried
                    end
                    return best, (best - myPos).Magnitude, bestV
                end
            end
        end
        if tried > maxCand then break end
    end

    if state.dodge._peakTried < tried then state.dodge._peakTried = tried end
    if not best then return nil, nil, nil end
    return best, (best - myPos).Magnitude, bestV
end

--==================================================
-- APPLY
--==================================================

local function applyDodge(safePos)
    if not char or not primary then return false end
    local ok = moveChar(char, primary, CFrame.new(safePos))
    if ok then zeroVelocityAll(char) end
    return ok
end

local function getStatsText()
    local d = state.dodge
    return string.format("рывков: %d · верт: %d · статик: %d · тач: %d",
        d._dodges, d._verticalDodges, d._staticDodges, d._touchDodges)
end

--==================================================
-- TRY DODGE (v14: ЕДИНСТВЕННЫЙ вызов за кадр)
--==================================================

local function tryDodge(part, threat, threats, isStatic)
    if not threat or not primary then return false end
    local d = state.dodge
    if d._attempted then return false end
    local now = os.clock()
    if now - d._lastGlobalDodge < d._globalCD then return false end
    -- v14: backoff после серии noSpace
    if now < d._noSpaceUntil then return false end

    -- v14: ставим флаг ДО дорогих вычислений
    d._attempted = true

    local ts = threatState[part]
    if not ts then ts = { lastDodge = 0, lastDist = 999 }; threatState[part] = ts end

    local urgency
    if threat.tti < 0.10 then urgency = "emergency"
    elseif threat.tti < 0.20 then urgency = "fast"
    else urgency = "normal" end

    local cd
    if isStatic then cd = 0.35
    else cd = (urgency == "emergency") and 0.04 or 0.08 end
    if now - ts.lastDodge < cd then return false end

    if ts.lastDodge > 0 and threat.dist < ts.lastDist - 0.5 then
        d._reEngage += 1
    end

    local myPos = primary.Position
    local safe, usedDist, isV = findBestDodgePosition(myPos, threat, threats, urgency)
    if not safe then
        ts.lastDodge = now; ts.lastDist = threat.dist
        d._noSpace += 1
        d._consecutiveNoSpace += 1
        -- v14: прогрессивный backoff
        local backoff = NOSPACE_BACKOFF_SHORT
        if d._consecutiveNoSpace >= NOSPACE_THRESHOLD_LONG then
            backoff = NOSPACE_BACKOFF_LONG
        elseif d._consecutiveNoSpace >= NOSPACE_THRESHOLD_SHORT then
            backoff = NOSPACE_BACKOFF_SHORT
        end
        d._noSpaceUntil = now + backoff
        dodgeStats.Text = getStatsText()
        return false
    end
    if not applyDodge(safe) then
        d._consecutiveNoSpace += 1
        return false
    end

    ts.lastDodge = now; ts.lastDist = threat.dist
    d._dodges += 1
    if urgency == "emergency" then d._emergency += 1 end
    if isV then d._verticalDodges += 1 end
    if isStatic then
        if isStatic == "touch" then d._touchDodges += 1
        else d._staticDodges += 1 end
    end
    d._lastGlobalDodge = now
    d._consecutiveNoSpace = 0
    d._lastPickedDist = usedDist or 14
    d._lastPickedVertical = isV
    dodgeStats.Text = getStatsText()
    distLabel.Text = string.format("последняя: %.0f studs · %s",
        usedDist or 14, isV and "верт" or "гориз")
    state.follow._pauseUntil = now + 0.5
    return true
end

