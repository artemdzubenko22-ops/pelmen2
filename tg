-- MAIN HEARTBEAT (Layers 1,2,4)
--==================================================

RunService.Heartbeat:Connect(function()
    local d = state.dodge
    if not d.enabled or not hrp or not hum or hum.Health <= 0 then return end
    local now = os.clock()
    local myPos = hrp.Position

    -- LAYER 4: health fallback
    if d._lastHealth and hum.Health < d._lastHealth - 0.01 then
        state.intel.liveSignals += 1
        local safePos = findSafeDodgePosition(myPos, nil, nil)
        doDodgeAt(safePos, true)
    end
    d._lastHealth = hum.Health

    -- LAYERS 1+2: velocity + delta
    overlapParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(myPos, d.reactRadius, overlapParams)

    for _, part in ipairs(parts) do
        if part ~= hrp then
            local tr = tracked[part]
            local velFromDelta = nil
            if tr then
                local dt = now - tr.t
                if dt > 0.001 then
                    velFromDelta = (part.Position - tr.pos) / dt
                end
            end
            tracked[part] = { pos = part.Position, t = now, lastSeen = now }

            local physVel = part.AssemblyLinearVelocity
            local bestVel, bestMag = nil, 0
            if velFromDelta then
                local m = velFromDelta.Magnitude
                if m > bestMag then bestVel, bestMag = velFromDelta, m end
            end
            local pm = physVel.Magnitude
            if pm > bestMag then bestVel, bestMag = physVel, pm end

            if bestVel and bestMag >= d.velocityMin then
                local toMe = myPos - part.Position
                local distToMe = toMe.Magnitude
                if distToMe > 0.5 then
                    local approach = bestVel.Unit:Dot(toMe.Unit)
                    local approaching = true
                    if tr then
                        local prevDist = (tr.pos - myPos).Magnitude
                        approaching = distToMe < prevDist + 0.05
                    end
                    if approach > d.approachDot and approaching then
                        state.intel.liveSignals += 1
                        local safePos = findSafeDodgePosition(myPos, part.Position, bestVel)
                        doDodgeAt(safePos, false)
                        break
                    end
                end
            end
        end
    end

    -- cleanup
    if now - trackLastCleanup > 1 then
        trackLastCleanup = now
        for p, tr in pairs(tracked) do
            if now - tr.lastSeen > TRACK_TTL or not p.Parent then
                tracked[p] = nil
            end
        end
        for p in pairs(lastDodgePerPart) do
            if not p.Parent then lastDodgePerPart[p] = nil end
        end
    end
end)

