local ATK_KEYS = {
    "attack","damage","hit","punch","swing","slash","shoot","shot","aim",
    "fire","explode","bomb","projectile","bullet","beam","melee","stab",
    "strike","kill","hurt","weapon","sword","blast","pierce","lunge",
