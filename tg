local function isPart(o)
    return o:IsA("BasePart") and not o:IsDescendantOf(player.Character or workspace)
end

local function teleportTo(part)
    if not part or not part.Parent then return end
    local ch = player.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local ok = pcall(function()
        ch:PivotTo(CFrame.new(part.Position + Vector3.new(0, 5, 0)))
    end)
    statusLabel.Text = ok and ("ТП → " .. part.Name) or "TP провален"
end

local function scanWorkspace()
    local list, seen = {}, {}
    local max = state.parts.maxList
    local q = string.lower(state.parts.filter)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if #list >= max then break end
        if isPart(obj) and not seen[obj] then
            if state.parts.showAnchoredOnly and not obj.Anchored then
                -- skip
            else
                local n = string.lower(obj.Name)
                if q == "" or string.find(n, q, 1, true) then
                    seen[obj] = true
                    table.insert(list, obj)
                end
            end
        end
    end
    state.parts._list = list
    statusLabel.Text = #list .. " частей"
end

function refreshPartList()
    for _, c in ipairs(partList:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    local list = state.parts._list
    for i, part in ipairs(list) do
        local row = Instance.new("Frame")
        row.LayoutOrder = i; row.Size = UDim2.new(1, -4, 0, 24)
        row.BackgroundTransparency = 1; row.Parent = partList

        local nb = mkBtn(row, part.Name .. " [" .. part.ClassName .. "]",
            UDim2.fromOffset(0, 0), UDim2.new(1, -56, 0, 22),
            Color3.fromRGB(48,48,60), Enum.Font.Gotham)
        nb.TextSize = 11
        nb.TextXAlignment = Enum.TextXAlignment.Left
        nb.TextTruncate = Enum.TextTruncate.AtEnd
        nb.Activated:Connect(function() teleportTo(part) end)

        local tpBtn = mkBtn(row, "ТП",
            UDim2.new(1, -52, 0, 0), UDim2.fromOffset(48, 22),
            Color3.fromRGB(120,25,45), Enum.Font.GothamBold)
        tpBtn.TextSize = 11
        tpBtn.Activated:Connect(function() teleportTo(part) end)
    end
end

