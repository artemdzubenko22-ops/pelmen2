threatParams.MaxParts = 8

-- v6: per-threat cooldown. [part] = {lastDodge, lastImpactDist, type}
local threatState = {}
local tracked = {}
local trackLastCleanup = 0
local TRACK_TTL = 0.5

local function getStatsText()
    local d = state.dodge
    return string.format("рывков: %d · отказов: %d · пере-рывков: %d · сигналов: %d",
        d._dodges, d._refused, d._reEngage, state.intel.liveSignals)
end

-- v6: классификация типа атаки
local function classifyThreat(part)
    if part:FindFirstChildWhichIsA("Beam") then return "beam" end
    if part:FindFirstChildWhichIsA("ParticleEmitter")
       or part:FindFirstChildWhichIsA("Trail")
       or part:FindFirstChildWhichIsA("Fire") then return "vfx" end
    if nameIsAttack(part.Name) then return "named" end
    if part.Size.Magnitude < 6 and not part.Anchored then return "projectile" end
    return "projectile"
end

-- v6: авто-калибровка реакции и TTI по наблюдаемым скоростям
local function calibrateThreat(vel, tti)
    local d = state.dodge
    d._calibSamples += 1
    d._calibSpeedSum += vel.Magnitude
    d._calibTtiSum += math.min(tti, 1)
    if d._calibSamples >= 20 then
        local avgSpeed = d._calibSpeedSum / d._calibSamples
        local avgTti = d._calibTtiSum / d._calibSamples
        -- скорость: чем быстрее снаряды, тем больше радиус детекта
        d.reactRadius = math.clamp(35 + avgSpeed * 0.8, 40, 120)
        -- реакция: быстрые снаряды требуют меньше запаса
        d._autoReaction = math.clamp(avgTti * 0.6, 0.06, 0.30)
        d._autoTti = math.clamp(avgTti * 0.9, 0.10, 0.45)
        d._calibSamples = 0; d._calibSpeedSum = 0; d._calibTtiSum = 0
    end
end

-- v6: анализ с TTI и предсказанием
local function analyzeThreat(part, myPos)
    local vel = part.AssemblyLinearVelocity
    local mag = vel.Magnitude
    if mag < 1 then return nil end
    local toMe = myPos - part.Position
    local dist = toMe.Magnitude
    if dist < 0.5 then return nil end
    local approach = vel.Unit:Dot(toMe.Unit)
    if approach < 0.10 then return nil end
    local closing = vel:Dot(toMe.Unit)
    if closing <= 0.1 then return nil end
    local tti = dist / closing
    calibrateThreat(vel, tti)

    local sizeBoost = math.clamp(part.Size.Magnitude / 6, 0.5, 2.0)
    local speedBoost = 1 + math.clamp(mag / 100, 0, 1) * 0.8
    local distOut = state.dodge.dodgeDist * sizeBoost * speedBoost

    return {
        tti = tti,
        impact = part.Position + vel * tti,
        vel = vel,
        dist = dist,
        approach = approach,
        mag = mag,
        dodgeDist = math.min(distOut, 45),
        type = classifyThreat(part),
    }
end

-- v6: безопасная позиция
local function hasFloor(pos)
    return workspace:Raycast(pos + Vector3.new(0, 0.5, 0), Vector3.new(0, -12, 0), envParams) ~= nil
end

local function isPositionSafe(pos)
    if not char or not hrp then return false end
    envParams.FilterDescendantsInstances = { char, workspace.CurrentCamera }
    local toTarget = pos - hrp.Position
    if toTarget.Magnitude > 0.1 then
        if workspace:Raycast(hrp.Position, toTarget, envParams) then return false end
    end
    threatParams.FilterDescendantsInstances = { char }
    local inPos = workspace:GetPartBoundsInRadius(pos, 1.2, threatParams)
    for _, p in ipairs(inPos) do
        if not p:IsDescendantOf(char) and p.CanCollide then return false end
    end
    local threats = workspace:GetPartBoundsInRadius(pos, state.dodge.safeMargin, threatParams)
    for _, p in ipairs(threats) do
        if not p:IsDescendantOf(char) and classifyThreat(p) ~= nil then return false end
    end
    return hasFloor(pos)
end

local function buildCandidates(myPos, threat)
    local bases = {}
    if threat and threat.impact then
        local away = Vector3.new(myPos.X - threat.impact.X, 0, myPos.Z - threat.impact.Z)
        if away.Magnitude > 0.1 then bases[#bases + 1] = away.Unit end
    end
    if threat and threat.vel and threat.vel.Magnitude > 0.1 then
        local v = Vector3.new(threat.vel.X, 0, threat.vel.Z)
        if v.Magnitude > 0.1 then
            v = v.Unit
            local perp = Vector3.new(-v.Z, 0, v.X)
            bases[#bases + 1] = perp
            bases[#bases + 1] = -perp
        end
    end
    if #bases == 0 then
        local a = math.random() * math.pi * 2
        bases[1] = Vector3.new(math.cos(a), 0, math.sin(a))
    end
    local seen, out = {}, {}
    for _, b in ipairs(bases) do
        for angle = -30, 30, 30 do
            local rot = CFrame.Angles(0, math.rad(angle), 0)
            local d = rot * b
            d = Vector3.new(d.X, 0, d.Z)
            if d.Magnitude > 0.01 then
                d = d.Unit
                local key = string.format("%.1f_%.1f", d.X, d.Z)
                if not seen[key] then seen[key] = true; out[#out + 1] = d end
            end
        end
    end
    return out
end

local function findSafeDodgePosition(myPos, threat, urgent)
    local dd = threat and threat.dodgeDist or state.dodge.dodgeDist
    local dirs = buildCandidates(myPos, threat)
    for _, d in ipairs(dirs) do
        local pos = myPos + d * dd
        if isPositionSafe(pos) then return pos end
    end
    if urgent and hasFloor(myPos + Vector3.new(0, 3, 0)) then
        return myPos + Vector3.new(0, 5, 0)
    end
    return nil
end

-- v6: ЯДРО — per-threat кулдаун и пере-рывок
local function tryDodgeForThreat(part, threat, urgent)
    local d = state.dodge
    local now = os.clock()
    local ts = threatState[part]
    if not ts then ts = { lastDodge = 0, lastImpactDist = 999, reCount = 0 } end

    -- per-threat кулдаун: если этот же снаряд уже требовал рывка < 0.18с назад — пропускаем
    local perCD = urgent and 0.06 or 0.14
    if now - ts.lastDodge < perCD then return false end

    -- пере-рывок: если после прошлого рывка снаряд всё ещё приближается — разрешаем снова
    local isReEngage = ts.lastDodge > 0 and threat.dist < ts.lastImpactDist - 0.5
    if isReEngage then d._reEngage += 1 end

    local safe = findSafeDodgePosition(hrp.Position, threat, urgent)
    if not safe then
        ts.lastDodge = now
        ts.lastImpactDist = threat.dist
        threatState[part] = ts
        d._refused += 1
        dodgeStats.Text = getStatsText()
        return false
    end

    ts.lastDodge = now
    ts.lastImpactDist = threat.dist
    ts.reCount = isReEngage and (ts.reCount + 1) or 0
    threatState[part] = ts

    d._dodges += 1
    dodgeStats.Text = getStatsText()
    pcall(function() char:PivotTo(CFrame.new(safe)) end)
    return true
end

