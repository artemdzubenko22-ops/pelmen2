local function scanScriptsAndRemotes()
    clearIntel()
    local nRemotes, nScripts = 0, 0
    for _, obj in ipairs(RS:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent")) and nameIsAttack(obj.Name) then
            nRemotes += 1
            if nRemotes <= 30 then addIntelRow("⚡ " .. obj:GetFullName(), Color3.fromRGB(255, 220, 100)) end
        end
    end
    local roots = { player }
    local ps = player:FindFirstChild("PlayerScripts")
    if ps then roots[#roots + 1] = ps end
    for _, root in ipairs(roots) do
        for _, dd in ipairs(root:GetDescendants()) do
            if dd:IsA("LocalScript") or dd:IsA("ModuleScript") then
                local ok, src = pcall(function() return dd.Source end)
                if ok and src and #src > 0 then
                    local hit = nil; local low = string.lower(src)
                    for i = 1, #ATK_KEYS do
                        if string.find(low, ATK_KEYS[i], 1, true) then hit = ATK_KEYS[i]; break end
                    end
                    if hit then
                        nScripts += 1
                        if nScripts <= 20 then
                            addIntelRow("📜 " .. dd:GetFullName() .. " · [" .. hit .. "]",
                                Color3.fromRGB(150, 255, 180))
                        end
                    end
                end
            end
        end
    end
    if nRemotes == 0 and nScripts == 0 then
        addIntelRow("· ничего подозрительного", Color3.fromRGB(150, 150, 170))
    end
    intelStatus.Text = string.format("remotes: %d · scripts: %d", nRemotes, nScripts)
end
