local function cleanupTables(now)
    for p, tr in pairs(tracked) do
        if now - tr.lastSeen > TRACK_TTL or not p.Parent then tracked[p] = nil end
    end
    for p, ts in pairs(threatState) do
        if not p.Parent or now - ts.lastDodge > 3 then threatState[p] = nil end
    end
    for p, tr in pairs(spawnTrack) do
        if not p.Parent or now - tr.t > SPAWNTRACK_TTL then spawnTrack[p] = nil end
    end
    for p in pairs(lastSpawnDodge) do
        if not p.Parent then lastSpawnDodge[p] = nil end
    end
end

RunService.Heartbeat:Connect(function()
    local now = os.clock()
    state.dodge._attempted = false

    -- ==== FOLLOW ====
    local f = state.follow
    if f.enabled and char and now > f._pauseUntil and not state.dodge._underThreat then
        if not f._target or not f._target.Parent then
            f._target = findPartByName(f.targetName)
            if f._target then
                followStatus.Text = "найден: " .. f.targetName
                followStatus.TextColor3 = Color3.fromRGB(150, 255, 180)
                f._lastPos = nil
            else
                followStatus.Text = "ждёт: " .. f.targetName
                followStatus.TextColor3 = Color3.fromRGB(255, 200, 80)
            end
        end
        if f._target and f._target.Parent then
            local targetPos = f._target.Position + f.offset
            if not f._lastPos or (targetPos - f._lastPos).Magnitude >= 0.1 then
                f._lastPos = targetPos
                local ok = moveChar(char, primary, CFrame.new(targetPos))
                if ok then zeroVelocityAll(char) end
            end
        end
    end

    -- ==== DODGE ====
    local d = state.dodge
    if not d.enabled then return end
    local myPos = getMyPos()
    if not myPos then d._underThreat = false; return end
    if hum and hum.Health <= 0 then d._underThreat = false; return end

    -- health fallback
    if hum and d._lastHealth and hum.Health < d._lastHealth - 0.01 then
        state.intel.liveSignals += 1
        if now - d._lastGlobalDodge >= d._globalCD then
            local safe = findSafeDodgePosition(myPos, nil, {}, "emergency")
            if safe and applyDodge(safe) then
                d._dodges += 1; d._emergency += 1
                d._lastGlobalDodge = now
                dodgeStats.Text = getStatsText()
                f._pauseUntil = now + 0.5
            end
        end
    end
    if hum then d._lastHealth = hum.Health end

    overlapParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(myPos, d.reactRadius, overlapParams)
    trackedCount = #parts

    local topThreats = { nil, nil, nil }
    local topScores = { 0, 0, 0 }
    local bestThreat, bestScore = nil, 0

    for i = 1, #parts do
        local part = parts[i]
        if part ~= primary then
            local tr = tracked[part]
            local vel
            if tr then
                local dt = now - tr.t
                if dt > 0.001 then vel = (part.Position - tr.pos) / dt end
                tr.pos = part.Position; tr.t = now; tr.lastSeen = now
            else
                tracked[part] = { pos = part.Position, t = now, lastSeen = now }
            end

            local physVel = part.AssemblyLinearVelocity
            local useVel = physVel
            if vel and vel.Magnitude > useVel.Magnitude then useVel = vel end

            if useVel.Magnitude >= 3 then
                local threat = analyzeThreat(part, myPos, useVel)
                if threat then
                    d._underThreat = true
                    local pri = 1
                    if threat.type == "beam" then pri = 3
                    elseif threat.type == "named" or threat.type == "tagged" then pri = 2 end
                    if threat.tti < 0.6 or threat.approach > 0.2 or threat.dist < 20 then
                        local score = pri * 10 + (1 - math.min(threat.tti, 1))
                        if score > topScores[3] then
                            if score > topScores[2] then
                                topThreats[3] = topThreats[2]; topScores[3] = topScores[2]
                                if score > topScores[1] then
                                    topThreats[2] = topThreats[1]; topScores[2] = topScores[1]
                                    topThreats[1] = threat; topScores[1] = score
                                else
                                    topThreats[2] = threat; topScores[2] = score
                                end
                            else
                                topThreats[3] = threat; topScores[3] = score
                            end
                        end
                        if score > bestScore then bestThreat = threat; bestScore = score end
                    end
                end
            end

            -- melee
            if part.Name == "HumanoidRootPart" and not bestThreat then
                local model = part.Parent
                if model and model ~= char then
                    local eHum = model:FindFirstChildOfClass("Humanoid")
                    if eHum and eHum.Health > 0 then
                        local toPlayer = myPos - part.Position
                        local dist = toPlayer.Magnitude
                        if dist < 12 and dist > 0.1
                           and part.CFrame.LookVector:Dot(toPlayer.Unit) > 0.5 then
                            local fake = {partPos=part.Position, impact=part.Position,
                                vel=toPlayer, dist=dist, tti=0.1, mag=20, partSize=4, part=part}
                            if tryDodge(part, fake, { fake }, false) then break end
                        end
                    end
                end
            end
        end
    end

    -- static zone
    if not d._attempted and now - lastStaticCheck > 0.05 then
        lastStaticCheck = now
        for i = 1, #parts do
            local part = parts[i]
            if part ~= primary and part.Parent then
                local dist = (part.Position - myPos).Magnitude
                if dist < 6.5 and isDangerPart(part) then
                    local ts = threatState[part]
                    if not ts or now - ts.lastDodge > 0.35 then
                        local st = makeStaticThreat(part, myPos)
                        if tryDodge(part, st, { st }, "zone") then break end
                    end
                end
            end
        end
    end

    -- touch
    if not d._attempted and now - lastTouchCheck > 0.1 and primary then
        lastTouchCheck = now
        local ok, touching = pcall(function() return primary:GetTouchingParts() end)
        if ok and touching then
            for i = 1, #touching do
                local tp = touching[i]
                if tp ~= primary and tp.Parent and isDangerPart(tp) then
                    local st = makeStaticThreat(tp, myPos)
                    if tryDodge(tp, st, { st }, "touch") then break end
                end
            end
        end
    end

    -- spawn-track deferred
    for part, tr in pairs(spawnTrack) do
        if part.Parent then
            local dt = now - tr.t
            if dt > 0.001 then
                local vel = (part.Position - tr.pos) / dt
                if vel.Magnitude >= 3 then
                    local threat = analyzeThreat(part, myPos, vel)
                    if threat and (threat.tti < 0.4 or threat.dist < 20) then
                        if tryDodge(part, threat, { threat }, false) then break end
                    end
                end
            end
        end
    end

    -- primary
    if bestThreat and not d._attempted then
        state.intel.liveSignals += 1
        local list = {}
        for i = 1, 3 do if topThreats[i] then list[#list+1] = topThreats[i] end end
        tryDodge(bestThreat.part, bestThreat, list, false)
    end

    if not d._underThreat then d._underThreat = (bestThreat ~= nil) end

    -- cleanup + info
    if now - trackLastCleanup > 0.8 then
        trackLastCleanup = now
        cleanupTables(now)
        if primary then
            bodyLabel.Text = string.format("тело: %s · %s", primary.Name, primary.ClassName)
            bodyLabel.TextColor3 = Color3.fromRGB(150, 255, 180)
        else
            bodyLabel.Text = "тело: нет primary"
            bodyLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end
end)

