--==================================================
-- CLASSIFY
--==================================================

local function classifyThreat(part)
    if part:FindFirstChildWhichIsA("Beam") then return "beam" end
    if part:FindFirstChildWhichIsA("ParticleEmitter")
        or part:FindFirstChildWhichIsA("Trail")
        or part:FindFirstChildWhichIsA("Fire") then return "vfx" end
    if nameIsAttack(part.Name) then return "named" end
    if hasHotTag(part) then return "tagged" end
    return "projectile"
end

local function isDangerPart(part)
    if not part or not part.Parent then return false end
    if char and part:IsDescendantOf(char) then return false end
    local cls = classifyThreat(part)
    if cls == "beam" or cls == "vfx" or cls == "named" or cls == "tagged" then
        return true
    end
    if part.Size.Magnitude < 8 and not part.Anchored then return true end
    if not part.CanCollide and part.Size.Magnitude < 15 then return true end
    return false
end

--==================================================
-- ANALYZE
--==================================================

local analysisPool = {}
local analysisIdx = 0
local function getAnalysis()
    analysisIdx = analysisIdx + 1
    if analysisIdx > 25 then analysisIdx = 1 end
    if not analysisPool[analysisIdx] then analysisPool[analysisIdx] = {} end
    return analysisPool[analysisIdx]
end

local function analyzeThreat(part, myPos, velOverride)
    local vel = velOverride or part.AssemblyLinearVelocity
    local mag = vel.Magnitude
    if mag < 3 then return nil end
    local dx = myPos.X - part.Position.X
    local dy = myPos.Y - part.Position.Y
    local dz = myPos.Z - part.Position.Z
    local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
    if dist < 0.5 then return nil end
    local invDist = 1 / dist
    local approach = (vel.X*dx + vel.Y*dy + vel.Z*dz) * invDist / mag
    if approach < 0.05 then return nil end
    local closing = mag * approach
    if closing <= 0.05 then return nil end
    local tti = dist / closing

    local a = getAnalysis()
    a.tti = tti
    a.partPos = part.Position
    a.impact = part.Position + vel * tti
    a.vel = vel
    a.dist = dist
    a.approach = approach
    a.mag = mag
    a.partSize = part.Size.Magnitude
    a.type = classifyThreat(part)
    a.part = part
    return a
end

local function makeStaticThreat(part, myPos)
    local dx = myPos.X - part.Position.X
    local dy = myPos.Y - part.Position.Y
    local dz = myPos.Z - part.Position.Z
    local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
    local a = getAnalysis()
    a.tti = 0.05
    a.partPos = part.Position
    a.impact = part.Position
    a.vel = Vector3.new(0.1, 0, 0.1)
    a.dist = dist
    a.approach = 1
    a.mag = 5
    a.partSize = part.Size.Magnitude
    a.type = classifyThreat(part)
    a.part = part
    return a
end

--==================================================
-- AUTO DIST
--==================================================

local function computeAutoDist(threat)
    if not threat then return 14 end
    local d = state.dodge
    local halfW = (threat.partSize or 4) * 0.5
    local base = 10
    base += math.min((threat.mag or 0) / 100, 2.5) * 3
    if threat.tti and threat.tti < 0.15 then base *= 1.25 end
    base = math.max(base, halfW + 8)
    return math.clamp(base, d.autoMinDist, d.autoMaxDist)
end

--==================================================
-- PATH / WALL / FLOOR
--==================================================

local function pathClear(dest, threat)
    if not threat or not threat.partPos then return true end
    local projHalf = (threat.partSize or 4) * 0.5
    local dx = dest.X - threat.partPos.X
    local dy = dest.Y - threat.partPos.Y
    local dz = dest.Z - threat.partPos.Z
    local dSq = dx*dx + dy*dy + dz*dz
    local minDSq = (projHalf + 3) * (projHalf + 3)
    if dSq < minDSq then return false end
    local v = threat.vel
    if not v or v.Magnitude < 0.3 then return true end
    local vLen = v.Magnitude
    local vx, vy, vz = v.X/vLen, v.Y/vLen, v.Z/vLen
    local alongPath = dx*vx + dy*vy + dz*vz
    if alongPath < 0 then return true end
    local px = dx - vx * alongPath
    local py = dy - vy * alongPath
    local pz = dz - vz * alongPath
    local perpDist = math.sqrt(px*px + py*py + pz*pz)
    return perpDist > (projHalf + 4)
end

local function isRealWall(hitPart)
    if not hitPart or not hitPart.Parent then return false end
    if char and hitPart:IsDescendantOf(char) then return false end
    if hitPart.Size.Magnitude < 8 then return false end
    if isDangerPart(hitPart) then return false end
    return true
end

local function wallClear(pos, fastMode)
    if not primary then return true end
    wallParams.FilterDescendantsInstances = { char, workspace.CurrentCamera }
    local from = primary.Position
    local iter = fastMode and 2 or 3
    for _ = 1, iter do
        local d = pos - from
        if d.Magnitude < 0.3 then return true end
        local hit = workspace:Raycast(from, d, wallParams)
        if not hit then return true end
        if isRealWall(hit.Instance) then return false end
        from = hit.Position + d.Unit * 0.3
    end
    return true
end

local function hasFloor(pos)
    floorParams.FilterDescendantsInstances = { char }
    return workspace:Raycast(pos + Vector3.new(0, 0.5, 0),
        Vector3.new(0, -20, 0), floorParams) ~= nil
end

--==================================================
-- BASES
--==================================================

local function buildBases(myPos, threat)
    local bases, seen = {}, {}
    local function add(vx, vz)
        local m = math.sqrt(vx*vx + vz*vz)
        if m < 0.05 then return end
        vx, vz = vx / m, vz / m
        local k = string.format("%d_%d", math.floor(vx*10), math.floor(vz*10))
        if seen[k] then return end
        seen[k] = true
        bases[#bases + 1] = Vector3.new(vx, 0, vz)
    end
    if threat and threat.vel and threat.vel.Magnitude > 0.5 then
        local v = threat.vel
        add(-v.Z, v.X)
        add(v.Z, -v.X)
    end
    if threat and threat.partPos then
        add(myPos.X - threat.partPos.X, myPos.Z - threat.partPos.Z)
    end
    add(1, 0); add(-1, 0); add(0, 1); add(0, -1)
    add(1, 1); add(-1, 1); add(1, -1); add(-1, -1)
    return bases
end

--==================================================
-- SAFE POSITION
--==================================================

local function isSpotSafe(pos, threats, urgency)
    for i = 1, #threats do
        if not pathClear(pos, threats[i]) then return false end
    end
    if not wallClear(pos, urgency == "emergency") then return false end
    if urgency == "normal" and hum and hum.FloorMaterial ~= Enum.Material.Air then
        if not hasFloor(pos) then return false end
    end
    if urgency == "normal" then
        threatParams.FilterDescendantsInstances = { char }
        local p = workspace:GetPartBoundsInRadius(pos, 2.5, threatParams)
        for i = 1, #p do
            if isDangerPart(p[i]) then return false end
        end
    end
    return true
end

local function findSafeDodgePosition(myPos, primaryThreat, threats, urgency)
    local dd = computeAutoDist(primaryThreat)
    local bases = buildBases(myPos, primaryThreat)
    local dists
    if urgency == "emergency" then dists = { dd, dd * 0.75 }
    elseif urgency == "fast" then dists = { dd, dd * 0.85, dd * 1.1 }
    else dists = { dd, dd * 0.85, dd * 1.15 } end

    local tries = 0
    for di = 1, #dists do
        local useDist = dists[di]
        for bi = 1, #bases do
            tries = tries + 1
            if tries > MAX_CANDIDATES then return nil end
            local b = bases[bi]
            local pos = myPos + Vector3.new(b.X * useDist, 0, b.Z * useDist)
            if isSpotSafe(pos, threats, urgency) then return pos, useDist end
        end
    end
    return nil
end

--==================================================
-- APPLY
--==================================================

local function applyDodge(safePos)
    if not char or not primary then return false end
    local ok = moveChar(char, primary, CFrame.new(safePos))
    if ok then zeroVelocityAll(char) end
    return ok
end

local function getStatsText()
    local d = state.dodge
    return string.format("рывков: %d · статик: %d · тач: %d · отказов: %d",
        d._dodges, d._staticDodges, d._touchDodges, d._refused + d._noSpace)
end

--==================================================
-- TRY DODGE
--==================================================

local function tryDodge(part, threat, threats, isStatic)
    if not threat or not primary then return false end
    local d = state.dodge
    if d._attempted then return false end
    local now = os.clock()
    if now - d._lastGlobalDodge < d._globalCD then return false end

    local ts = threatState[part]
    if not ts then ts = { lastDodge = 0, lastDist = 999 }; threatState[part] = ts end

    local urgency
    if threat.tti < 0.10 then urgency = "emergency"
    elseif threat.tti < 0.20 then urgency = "fast"
    else urgency = "normal" end

    local cd
    if isStatic then cd = 0.35
    else cd = (urgency == "emergency") and 0.04 or 0.08 end
    if now - ts.lastDodge < cd then return false end

    if ts.lastDodge > 0 and threat.dist < ts.lastDist - 0.5 then
        d._reEngage += 1
    end

    local myPos = primary.Position
    local safe, usedDist = findSafeDodgePosition(myPos, threat, threats, urgency)
    if not safe then
        ts.lastDodge = now; ts.lastDist = threat.dist
        d._noSpace += 1; d._attempted = true
        dodgeStats.Text = getStatsText()
        return false
    end
    if not applyDodge(safe) then d._attempted = true; return false end

    ts.lastDodge = now; ts.lastDist = threat.dist
    d._dodges += 1
    if urgency == "emergency" then d._emergency += 1 end
    if isStatic then
        if isStatic == "touch" then d._touchDodges += 1
        else d._staticDodges += 1 end
    end
    d._lastGlobalDodge = now; d._attempted = true
    dodgeStats.Text = getStatsText()
    distLabel.Text = string.format("авто-дистанция: ~%.0f studs", usedDist or 14)
    state.follow._pauseUntil = now + 0.5
    return true
end

