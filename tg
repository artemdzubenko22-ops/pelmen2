local ATK_KEYS = {
    "attack","damage","hit","punch","swing","slash","shoot","shot","aim",
    "fire","explode","bomb","projectile","bullet","beam","melee","stab",
    "strike","kill","hurt","weapon","sword","blast","pierce","lunge",
    "bone","spike","gaster","blaster","hand","smash","pull","meteor",
    "zone","hazard","hitbox","aoe","range","danger",
}
local function nameIsAttack(name)
    local n = string.lower(name)
    for i = 1, #ATK_KEYS do
        if string.find(n, ATK_KEYS[i], 1, true) then return true end
    end
    return false
end

local HOT_TAGS = {"Projectile","Attack","Damage","Hitbox","Hazard",
    "DamageZone","Bullet","Enemy","Kill","Danger"}
local function hasHotTag(part)
    for i = 1, #HOT_TAGS do
        if CS:HasTag(part, HOT_TAGS[i]) then return true end
    end
    return false
end

