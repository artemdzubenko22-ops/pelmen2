--==================================================
-- THREAT CLASSIFY + ANALYZE
--==================================================

local function classifyThreat(part)
    if part:FindFirstChildWhichIsA("Beam") then return "beam" end
    if part:FindFirstChildWhichIsA("ParticleEmitter")
       or part:FindFirstChildWhichIsA("Trail")
       or part:FindFirstChildWhichIsA("Fire") then return "vfx" end
    if nameIsAttack(part.Name) then return "named" end
    if part.Size.Magnitude < 6 and not part.Anchored then return "projectile" end
    return "projectile"
end

local function analyzeThreat(part, myPos)
    local vel = part.AssemblyLinearVelocity
    local mag = vel.Magnitude
    if mag < 6 then return nil end
    local toMe = myPos - part.Position
    local dist = toMe.Magnitude
    if dist < 0.5 then return nil end
    local approach = vel.Unit:Dot(toMe.Unit)
    if approach < 0.10 then return nil end
    local closing = vel:Dot(toMe.Unit)
    if closing <= 0.1 then return nil end
    local tti = dist / closing

    local sizeBoost = math.clamp(part.Size.Magnitude / 6, 0.5, 2.0)
    local speedBoost = 1 + math.clamp(mag / 100, 0, 1) * 0.8
    local distOut = state.dodge.dodgeDist * sizeBoost * speedBoost

    return {
        tti = tti,
        impact = part.Position + vel * tti,
        vel = vel, dist = dist, approach = approach, mag = mag,
        dodgeDist = math.min(distOut, 45),
        type = classifyThreat(part),
    }
end

--==================================================
-- FAST DODGE POSITION — tiered validation
--==================================================

local function hasFloor(pos)
    return workspace:Raycast(pos + Vector3.new(0, 0.5, 0), Vector3.new(0, -12, 0), envParams) ~= nil
end

-- уровень 1: только стена (самое дешёвое)
local function wallClear(pos)
    if not hrp then return true end
    envParams.FilterDescendantsInstances = { char, workspace.CurrentCamera }
    local d = pos - hrp.Position
    if d.Magnitude < 0.1 then return true end
    return workspace:Raycast(hrp.Position, d, envParams) == nil
end

-- уровень 2: стена + пол + чужие атаки
local function fullSafe(pos)
    if not wallClear(pos) then return false end
    if not hasFloor(pos) then return false end
    threatParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(pos, state.dodge.safeMargin, threatParams)
    for _, p in ipairs(parts) do
        if not p:IsDescendantOf(char) then
            local cls = classifyThreat(p)
            if cls and (cls == "beam" or cls == "vfx" or nameIsAttack(p.Name)
                or (p.Size.Magnitude < 6 and not p.Anchored)) then
                return false
            end
        end
    end
    return true
end

-- построить базовые направления (от точки удара, перпендикуляр к скорости)
local function baseDirs(myPos, threat)
    local bases = {}
    if threat and threat.impact then
        local a = Vector3.new(myPos.X - threat.impact.X, 0, myPos.Z - threat.impact.Z)
        if a.Magnitude > 0.1 then bases[#bases + 1] = a.Unit end
    end
    if threat and threat.vel and threat.vel.Magnitude > 0.1 then
        local v = Vector3.new(threat.vel.X, 0, threat.vel.Z)
        if v.Magnitude > 0.1 then
            v = v.Unit
            bases[#bases + 1] = Vector3.new(-v.Z, 0, v.X)
            bases[#bases + 1] = Vector3.new(v.Z, 0, -v.X)
        end
    end
    if #bases == 0 then
        local a = math.random() * math.pi * 2
        bases[1] = Vector3.new(math.cos(a), 0, math.sin(a))
    end
    return bases
end

-- v7: по уровню urgency
local function findSafeDodgePosition(myPos, threat, urgency)
    -- urgency: "emergency" | "fast" | "normal"
    local dd = threat and threat.dodgeDist or state.dodge.dodgeDist
    local bases = baseDirs(myPos, threat)

    if urgency == "emergency" then
        -- 1-2 кандидата, стена-only, никаких пола/атак
        for i = 1, math.min(#bases, 2) do
            local pos = myPos + bases[i] * dd
            if wallClear(pos) then return pos end
        end
        -- совсем плохо — вертикально вверх
        return myPos + Vector3.new(0, dd * 0.7, 0)
    elseif urgency == "fast" then
        -- 3 кандидата: стена + пол (без атак в точке)
        for i = 1, math.min(#bases, 3) do
            local pos = myPos + bases[i] * dd
            if wallClear(pos) and hasFloor(pos) then return pos end
        end
        -- fallback: только стена
        for i = 1, math.min(#bases, 3) do
            local pos = myPos + bases[i] * dd
            if wallClear(pos) then return pos end
        end
        return nil
    else
        -- normal: 5 кандидатов, полная проверка
        local seen, out = {}, {}
        for _, b in ipairs(bases) do
            for angle = -30, 30, 30 do
                local rot = CFrame.Angles(0, math.rad(angle), 0)
                local d = rot * b
                d = Vector3.new(d.X, 0, d.Z)
                if d.Magnitude > 0.01 then
                    d = d.Unit
                    local key = string.format("%.1f_%.1f", d.X, d.Z)
                    if not seen[key] then seen[key] = true; out[#out + 1] = d end
                end
                if #out >= 5 then break end
            end
            if #out >= 5 then break end
        end
        for _, d in ipairs(out) do
            local pos = myPos + d * dd
            if fullSafe(pos) then return pos end
        end
        return nil
    end
end

--==================================================
-- APPLY DODGE — v7: velocity zero (ключевой фикс)
--==================================================

local function applyDodge(safePos, type)
    if not char or not hrp then return false end
    local ok = pcall(function() char:PivotTo(CFrame.new(safePos)) end)
    if ok then
        -- КРИТИЧНО: обнулить скорость, чтобы не улететь обратно в хитбокс
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        return true
    end
    return false
end

local function registerDodge(type)
    local d = state.dodge
    d._dodges += 1
    if type == "emergency" then d._emergency += 1 end
    dodgeStats.Text = getStatsText()
end

--==================================================
-- TRY DODGE — per-threat cooldown + urgency check
--==================================================

local function tryDodge(part, threat)
    if not threat or not hrp then return false end
    local now = os.clock()
    local ts = threatState[part]
    if not ts then ts = { lastDodge = 0, lastDist = 999 } end

    -- per-threat cooldown: 0.05с emergency, 0.10с normal
    local urgency
    if threat.tti < 0.10 then urgency = "emergency"
    elseif threat.tti < 0.20 then urgency = "fast"
    else urgency = "normal" end

    local cd = (urgency == "emergency") and 0.05 or 0.10
    if now - ts.lastDodge < cd then return false end

    -- пере-рывок логика
    if ts.lastDodge > 0 and threat.dist < ts.lastDist - 0.5 then
        state.dodge._reEngage += 1
    end

    local safe = findSafeDodgePosition(hrp.Position, threat, urgency)
    if not safe then
        ts.lastDodge = now; ts.lastDist = threat.dist
        threatState[part] = ts
        state.dodge._refused += 1
        dodgeStats.Text = getStatsText()
        return false
    end
    if not applyDodge(safe, urgency) then return false end

    ts.lastDodge = now; ts.lastDist = threat.dist
    threatState[part] = ts
    registerDodge(urgency)
    return true
end

