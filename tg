local pendingSpawn = {}
local spawnCheckQueued = false
local lastSpawnDodge = {}

workspace.DescendantAdded:Connect(function(o)
    if not state.dodge.enabled then return end
    if not o:IsA("BasePart") then return end
    pendingSpawn[#pendingSpawn + 1] = o
    if spawnCheckQueued then return end
    spawnCheckQueued = true
    task.defer(function()
        spawnCheckQueued = false
        local list = pendingSpawn; pendingSpawn = {}
        if not hrp then return end
        local myPos = hrp.Position
        for _, part in ipairs(list) do
            if part.Parent then
                local dist = (part.Position - myPos).Magnitude
                if dist <= state.dodge.reactRadius then
                    local hot = (dist < 3.5) or nameIsAttack(part.Name)
                        or part:FindFirstChildWhichIsA("ParticleEmitter")
                        or part:FindFirstChildWhichIsA("Beam")
                        or part:FindFirstChildWhichIsA("Trail")
                        or part:FindFirstChildWhichIsA("Fire")
                        or (part.Size.Magnitude < 6 and not part.Anchored)
                    if hot then
                        local now = os.clock()
                        if now - (lastSpawnDodge[part] or 0) > 0.10 then
                            lastSpawnDodge[part] = now
                            state.intel.liveSignals += 1
                            local threat = analyzeThreat(part, myPos) or {
                                dodgeDist = state.dodge.dodgeDist,
                                dist = dist, impact = part.Position,
                                vel = Vector3.zero, tti = 0,
                            }
                            tryDodge(part, threat)
                        end
                    end
                    tracked[part] = { pos = part.Position, t = os.clock(), lastSeen = os.clock() }
                end
            end
        end
    end)
end)

--==================================================
-- SINGLE HEARTBEAT — dodge + follow merged
--==================================================

RunService.Heartbeat:Connect(function()
    local now = os.clock()

    -- ==== FOLLOW ====
    local f = state.follow
    if f.enabled and char then
        if not f._target or not f._target.Parent then
            f._target = findPartByName(f.targetName)
            if f._target then
                followStatus.Text = "найден: " .. f.targetName
                followStatus.TextColor3 = Color3.fromRGB(150, 255, 180)
                f._lastPos = nil
            else
                followStatus.Text = "ждёт: " .. f.targetName
                followStatus.TextColor3 = Color3.fromRGB(255, 200, 80)
            end
        end
        if f._target and f._target.Parent then
            local targetPos = f._target.Position + f.offset
            if not f._lastPos or (targetPos - f._lastPos).Magnitude >= 0.1 then
                f._lastPos = targetPos
                pcall(function() char:PivotTo(CFrame.new(targetPos)) end)
                if hrp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end

    -- ==== DODGE ====
    local d = state.dodge
    if not d.enabled or not hrp or not hum or hum.Health <= 0 then return end
    local myPos = hrp.Position

    -- health fallback
    if d._lastHealth and hum.Health < d._lastHealth - 0.01 then
        state.intel.liveSignals += 1
        local safe = findSafeDodgePosition(myPos, nil, "emergency")
        if safe and applyDodge(safe, "emergency") then
            registerDodge("emergency")
        end
    end
    d._lastHealth = hum.Health

    overlapParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(myPos, d.reactRadius, overlapParams)

    -- find highest-priority threat this frame
    local bestPart, bestThreat, bestPri = nil, nil, 0
    for _, part in ipairs(parts) do
        if part ~= hrp then
            local tr = tracked[part]
            local velFromDelta
            if tr then
                local dt = now - tr.t
                if dt > 0.001 then velFromDelta = (part.Position - tr.pos) / dt end
            end
            tracked[part] = { pos = part.Position, t = now, lastSeen = now }

            local vel = part.AssemblyLinearVelocity
            if velFromDelta and velFromDelta.Magnitude > vel.Magnitude then vel = velFromDelta end

            if vel.Magnitude >= 6 then
                local threat = analyzeThreat(part, myPos)
                if threat then
                    local pri = 1
                    if threat.type == "beam" then pri = 3
                    elseif threat.type == "named" then pri = 2 end
                    -- быстрый триггер: TTI < 0.25 ИЛИ approach > 0.55
                    if threat.tti < 0.25 or threat.approach > 0.55 then
                        -- срочность: чем меньше TTI, тем выше приоритет
                        local urgencyScore = pri * 10 + (1 - math.min(threat.tti, 1))
                        if urgencyScore > bestPri then
                            bestPart, bestThreat, bestPri = part, threat, urgencyScore
                        end
                    end
                end
            end

            -- melee
            if not bestPart and part.Name == "HumanoidRootPart" then
                local model = part.Parent
                if model and model ~= char then
                    local eHum = model:FindFirstChildOfClass("Humanoid")
                    if eHum and eHum.Health > 0 then
                        local toPlayer = myPos - part.Position
                        local dist = toPlayer.Magnitude
                        if dist < 12 and part.CFrame.LookVector:Dot(toPlayer.Unit) > 0.5 then
                            local safe = findSafeDodgePosition(myPos, {
                                dodgeDist = math.max(8, dist + 6),
                                impact = part.Position,
                                vel = toPlayer.Unit,
                            }, "fast")
                            if safe and applyDodge(safe, "fast") then
                                registerDodge("fast")
                            end
                        end
                    end
                end
            end
        end
    end

    if bestPart and bestThreat then
        state.intel.liveSignals += 1
        tryDodge(bestPart, bestThreat)
    end

    -- cleanup
    if now - trackLastCleanup > 1 then
        trackLastCleanup = now
        for p, tr in pairs(tracked) do
            if now - tr.lastSeen > TRACK_TTL or not p.Parent then tracked[p] = nil end
        end
        for p in pairs(threatState) do if not p.Parent then threatState[p] = nil end end
        for p in pairs(lastSpawnDodge) do if not p.Parent then lastSpawnDodge[p] = nil end end
    end
end)

