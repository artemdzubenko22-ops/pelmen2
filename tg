local function corner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 5); c.Parent = p; return c
end
local function mkBtn(parent, text, pos, size, bg, font, ts)
    local b = Instance.new("TextButton")
    b.Position = pos or UDim2.fromOffset(0, 0); b.Size = size
    b.BackgroundColor3 = bg or Color3.fromRGB(120, 25, 45)
    b.BorderSizePixel = 0; b.Text = text
    b.TextColor3 = Color3.new(1,1,1); b.TextScaled = (ts == nil)
    b.Font = font or Enum.Font.GothamBold; b.AutoButtonColor = true
    b.Parent = parent; corner(b, 5); if ts then b.TextSize = ts end
    return b
end
local function mkLabel(parent, text, pos, size, align)
    local t = Instance.new("TextLabel")
    t.Position = pos; t.Size = size; t.BackgroundTransparency = 1
    t.Text = text; t.TextColor3 = Color3.fromRGB(230,230,230)
    t.TextScaled = true; t.TextXAlignment = align or Enum.TextXAlignment.Left
    t.Font = Enum.Font.Gotham; t.Parent = parent; return t
end
local function mkToggle(parent, text, pos, size, getter, setter)
    local b = mkBtn(parent, "", pos, size, Color3.fromRGB(48,48,60), Enum.Font.Gotham)
    local function refresh()
        local on = getter()
        b.Text = (on and "✓ " or "○ ") .. text
        b.BackgroundColor3 = on and Color3.fromRGB(35,115,65) or Color3.fromRGB(48,48,60)
    end
    b.Activated:Connect(function() setter(not getter()); refresh() end)
    refresh(); return b
end

