task.spawn(function()
    while true do
        task.wait(0.5)
        if not char then
            if player.Character then updateChar(player.Character) end
        else
            local needRefresh = false
            if player.Character ~= char then
                needRefresh = true
            elseif not primary or not primary.Parent or not primary:IsDescendantOf(char) then
                needRefresh = true
            elseif not hum or not hum.Parent or not hum:IsDescendantOf(char) then
