--==============================
-- DODGE LOGIC
--==============================

local dodgeStats_counter = { dodges = 0, projectiles = 0 }

local function doDodge(perp)
    local d = state.dodge
    local now = os.clock()
    if now - d._lastDodge < d.cooldown then return end
    local ch = player.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    d._lastDodge = now
    dodgeStats_counter.dodges += 1
    dodgeStats.Text = string.format("уклонений: %d · снарядов: %d",
        dodgeStats_counter.dodges, dodgeStats_counter.projectiles)
    local dropPoint = hrp.Position + perp * d.dodgeDist
        + Vector3.new(0, d.verticalBias * d.dodgeDist, 0)
    pcall(function() ch:PivotTo(CFrame.new(dropPoint)) end)
end

local function computeDodgeVector(part, myPos)
    local vel = part.AssemblyLinearVelocity
    if vel.Magnitude < 1 then return nil end
    local toMe = (myPos - part.Position)
    local dist = toMe.Magnitude
    if dist < 0.5 then return nil end
    local approach = vel.Unit:Dot(toMe.Unit)
    if approach < state.dodge.approachDot then return nil end
    -- горизонтальный перпендикуляр к вектору полёта
    local v = vel.Unit
    local perp = Vector3.new(-v.Z, 0, v.X)
    if perp.Magnitude < 0.1 then perp = Vector3.new(1, 0, 0) end
    perp = perp.Unit
    -- выбираем сторону, дальше от снаряда, чтобы не пересечь его траекторию
    local left  = myPos + perp * state.dodge.dodgeDist
    local right = myPos - perp * state.dodge.dodgeDist
    local dLeft  = (left  - part.Position).Magnitude
    local dRight = (right - part.Position).Magnitude
    return dLeft > dRight and perp or -perp
end

RunService.Heartbeat:Connect(function()
    local d = state.dodge
    if not d.enabled then return end
    local ch = player.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    -- 1) страховка через Health
    if d._lastHealth and hum.Health < d._lastHealth - 0.01 then
        dodgeStats_counter.projectiles += 1
        local angle = math.random() * math.pi * 2
        doDodge(Vector3.new(math.cos(angle), 0, math.sin(angle)))
    end
    d._lastHealth = hum.Health

    -- 2) детект снарядов по velocity
    local myPos = hrp.Position
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart")
           and not part:IsDescendantOf(ch)
           and part.AssemblyLinearVelocity.Magnitude >= d.velocityMin then
            local dist = (part.Position - myPos).Magnitude
            if dist <= d.reactRadius then
                local perp = computeDodgeVector(part, myPos)
                if perp then
                    dodgeStats_counter.projectiles += 1
                    doDodge(perp)
                    break  -- одного доджа за кадр достаточно
                end
            end
        end
    end
end)

