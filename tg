--==================================================

local char, primary, hum = nil, nil, nil
local hoverAtt, hoverLV, hoverAO = nil, nil, nil

-- Цепочка fallback для главной части персонажа
local function resolvePrimary(c)
    if not c then return nil end
    if c.PrimaryPart and c.PrimaryPart:IsA("BasePart") then return c.PrimaryPart end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    for _, name in ipairs({"UpperTorso","Torso","LowerTorso","Head","Pelvis","RootPart"}) do
        local p = c:FindFirstChild(name)
        if p and p:IsA("BasePart") then return p end
    end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    return nil
end

local function resolveHumanoid(c)
    if not c then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then return h end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("Humanoid") then return d end
    end
    return nil
end

local function getMyPos()
    if primary and primary.Parent then return primary.Position end
    if char then
        local ok, cf = pcall(function() return char:GetPivot() end)
        if ok and cf then return cf.Position end
    end
    return nil
end

-- zero velocity на всех частях (для морфов с несколькими движущимися)
local function zeroVelocityAll(c)
    if not c then return end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") then
            pcall(function()
                d.AssemblyLinearVelocity = Vector3.zero
                d.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end
end

-- pivot с fallback: PivotTo → verify → прямой CFrame на primary
local function moveChar(c, pri, cf)
    if not c then return false end
    -- Попытка 1: PivotTo + verify
    local beforePos = pri and pri.Position
    local ok = pcall(function() c:PivotTo(cf) end)
    if ok and beforePos and pri and pri.Parent then
        if (pri.Position - beforePos).Magnitude > 0.3 then return true end
        -- не сдвинулось — вероятно anchored
    elseif ok then
        return true
    end
    -- Попытка 2: прямое CFrame на primary
    if pri and pri.Parent then
        local wasAnchored = pri.Anchored
        if wasAnchored then
            local ok2 = pcall(function()
                pri.Anchored = false
                pri.CFrame = cf
                pri.Anchored = true
            end)
            if ok2 then return true end
        else
            local ok2 = pcall(function() pri.CFrame = cf end)
            if ok2 then return true end
        end
    end
    return false
end

local function clearHoverInstances()
    if hoverLV then hoverLV:Destroy(); hoverLV = nil end
    if hoverAO then hoverAO:Destroy(); hoverAO = nil end
    if hoverAtt then hoverAtt:Destroy(); hoverAtt = nil end
end

local function updateHover()
    if not char or not primary or not hum then return end
    if state.dodge.hoverEnabled and hum.Health > 0 then
        if not hoverAtt or not hoverAtt.Parent then
            hoverAtt = Instance.new("Attachment")
            hoverAtt.Name = "FNV_HoverAtt"; hoverAtt.Parent = primary
        elseif hoverAtt.Parent ~= primary then
            hoverAtt.Parent = primary
        end
        if not hoverLV or not hoverLV.Parent then
            hoverLV = Instance.new("LinearVelocity")
            hoverLV.Attachment0 = hoverAtt; hoverLV.VectorVelocity = Vector3.zero
            hoverLV.MaxForce = math.huge
            hoverLV.RelativeTo = Enum.ActuatorRelativeTo.World
            hoverLV.Parent = primary
        else
            hoverLV.Attachment0 = hoverAtt
        end
        if not hoverAO or not hoverAO.Parent then
            hoverAO = Instance.new("AlignOrientation")
            hoverAO.Mode = Enum.OrientationAlignmentMode.OneAttachment
            hoverAO.Attachment0 = hoverAtt; hoverAO.CFrame = primary.CFrame
            hoverAO.MaxTorque = math.huge; hoverAO.Responsiveness = 30
            hoverAO.Parent = primary
        else
            hoverAO.Attachment0 = hoverAtt
        end
        hum.PlatformStand = true
    else
        clearHoverInstances()
        if hum and hum.Parent then hum.PlatformStand = false end
    end
end

local hoverBtn
local function setHover(on)
    state.dodge.hoverEnabled = on
    updateHover()
    if hoverBtn then
        hoverBtn.Text = (on and "✓ " or "○ ") .. "ЗАСТЫТЬ В ВОЗДУХЕ [H]"
        hoverBtn.BackgroundColor3 = on and Color3.fromRGB(35, 115, 65)
            or Color3.fromRGB(48, 48, 60)
    end
end

local function updateChar(c)
    char = c; primary = nil; hum = nil
    clearHoverInstances()
    if c then
        primary = resolvePrimary(c)
        hum = resolveHumanoid(c)
        if hum then state.dodge._lastHealth = hum.Health end
        if state.dodge.hoverEnabled then task.defer(updateHover) end
    end
end

