local dragging, dragStart, startPos = false, nil, nil
local resizing, rStart, rStartSize = false, nil, nil

dragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        startPos  = frame.Position
    end
end)

local rh = mkBtn(frame, "◢", UDim2.new(1, -14, 1, -14),
    UDim2.fromOffset(12, 12), Color3.fromRGB(255, 40, 65))
rh.ZIndex = 20; rh.TextSize = 8
rh.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        resizing = true
        rStart = Vector2.new(input.Position.X, input.Position.Y)
        rStartSize = frame.AbsoluteSize
    end
end)

UIS.InputChanged:Connect(function(input)
    local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    if not isMouse then return end
    local cur = Vector2.new(input.Position.X, input.Position.Y)
    if dragging then
        local d = cur - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y)
    elseif resizing then
        local d = cur - rStart
        frame.Size = UDim2.fromOffset(
            math.max(240, rStartSize.X + d.X),
            math.max(240, rStartSize.Y + d.Y))
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false; resizing = false
    end
end)

