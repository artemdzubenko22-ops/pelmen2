local hookedRemotes = {}
local function hookRemote(inst)
    if hookedRemotes[inst] then return end
    if not (inst:IsA("RemoteEvent") or inst:IsA("UnreliableRemoteEvent")) then return end
    hookedRemotes[inst] = true
    inst.OnClientEvent:Connect(function()
        if nameIsAttack(inst.Name) and state.dodge.enabled and hrp then
            state.intel.liveSignals += 1
            local safe = findSafeDodgePosition(hrp.Position, nil, "emergency")
            if safe and applyDodge(safe, "emergency") then registerDodge("emergency") end
        end
    end)
end
